                                    span(class="font-semibold text-violet-800") ByteTrack 추적 + 윈도우
                                div(class="flex items-center justify-between text-sm")
                                    span(class="text-slate-600") 모델
                                    span(class="font-semibold text-violet-800") XGBoost
                                div(class="flex items-center justify-between text-sm")
                                    span(class="text-slate-600") 낙상 임계값
                                    span(class="font-semibold text-violet-800") 50%
                                div(class="flex items-center justify-between text-sm")
                                    span(class="text-slate-600") 학습 데이터
                                    span(class="font-semibold text-violet-800") 1500건 (XGBoost v2)
                                div(class="flex items-center justify-between text-sm")
                                    span(class="text-slate-600") 예상 소요 시간
                                    span(class="font-semibold text-violet-800") ~15초

                div(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm")
                    h2(class="text-xl font-semibold text-slate-950") 처리 단계
                    div(class="mt-5 grid gap-3 md:grid-cols-5")
                        div(*ngFor="let step of prototypeInfo?.analysis_steps; let idx = index", class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 text-center")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-400") Step {{idx + 1}}
                            p(class="mt-2 text-sm font-semibold text-slate-900") {{step}}

                div(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm")
                    div(class="flex items-center justify-between gap-3")
                        h2(class="text-xl font-semibold text-slate-950") 현재 사용 중인 분석 레이어
                        span(class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", [ngClass]="statusBadgeClass(prototypeInfo?.analysis_engine_summary?.current_runtime?.key)") {{prototypeInfo?.analysis_engine_summary?.current_runtime?.key}}
                    div(class="mt-5 grid gap-3")
                        div(*ngFor="let layer of prototypeInfo?.analysis_engine_summary?.layers", class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4")
                            div(class="flex items-center justify-between gap-3")
                                p(class="text-sm font-semibold text-slate-900") {{layer.title}}
                                span(class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", [ngClass]="statusBadgeClass(layer.status)") {{layer.status}}
                            p(class="mt-2 text-sm text-slate-700") {{layer.active_label}}
                            p(class="mt-2 text-xs text-slate-500") summary {{layer.summary_exists ? '있음' : '없음'}} · model {{layer.model_exists ? '있음' : '없음'}} · samples {{layer.sample_count}}

                div(class="rounded-3xl border border-slate-200 bg-slate-950 p-6 text-white shadow-sm")
                    h2(class="text-xl font-semibold") 실시간 전환 계획
                    p(class="mt-3 text-sm leading-7 text-slate-300") {{prototypeInfo?.realtime_readiness?.headline}}
                    div(class="mt-5 grid gap-3 md:grid-cols-3")
                        div(*ngFor="let item of prototypeInfo?.realtime_readiness?.recommended_stack", class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4")
                            div(class="flex items-center justify-between gap-2")
                                p(class="text-sm font-semibold text-white") {{item.title}}
                                span(class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", [ngClass]="statusBadgeClass(item.status)") {{item.status}}
                            p(class="mt-2 text-sm text-slate-300") {{item.description}}
                    ul(class="mt-5 space-y-2")
                        li(*ngFor="let item of prototypeInfo?.camera_transition_plan", class="text-sm text-slate-300") • {{item}}

            div(class="space-y-6")
                div(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm")
                    h2(class="text-xl font-semibold text-slate-950") 모델 설명 카드
                    p(class="mt-3 text-sm leading-7 text-slate-600") {{prototypeInfo?.model_explanation?.headline}}
                    div(class="mt-5 space-y-3")
                        div(*ngFor="let card of prototypeInfo?.model_explanation?.cards", class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4")
                            div(class="flex items-center justify-between gap-3")
                                p(class="text-sm font-semibold text-slate-900") {{card.title}}
                                span(class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", [ngClass]="statusBadgeClass(card.status)") {{card.status}}
                            p(class="mt-2 text-sm text-slate-700") {{card.summary}}
                            ul(class="mt-3 space-y-1")
                                li(*ngFor="let item of card.items", class="text-xs text-slate-500") • {{item}}

                div(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm")
                    h2(class="text-xl font-semibold text-slate-950") RF 보조 파이프라인 모델
                    div(class="mt-3 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3")
                        p(class="text-sm font-semibold text-sky-800") {{prototypeInfo?.trained_model?.metric_note || '3-Fold 교차 검증 기준 메트릭'}}
                    div(class="mt-5 grid gap-3 md:grid-cols-2")
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-400") 모델/가중치
                            p(class="mt-2 text-sm font-semibold text-slate-900") {{prototypeInfo?.trained_model?.model_name || '-'}}
                            p(class="mt-2 text-xs text-slate-500") {{prototypeInfo?.trained_model?.weights_path || '-'}}
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-400") 학습 데이터
                            p(class="mt-2 text-sm font-semibold text-slate-900") 총 {{prototypeInfo?.trained_model?.sample_count || 0}}건
                            p(class="mt-1 text-xs text-slate-400") {{prototypeInfo?.trained_model?.split_note}}
                    div(class="mt-5 grid gap-3 md:grid-cols-3", *ngIf="prototypeInfo?.trained_model?.rf_pipeline?.metric_ready")
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-xs text-slate-400") CV F1
                            p(class="mt-2 text-lg font-bold text-slate-900") {{prototypeInfo?.trained_model?.rf_pipeline?.cv_f1 * 100 | number:'1.0-1'}}%
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-xs text-slate-400") CV AUC
                            p(class="mt-2 text-lg font-bold text-slate-900") {{prototypeInfo?.trained_model?.rf_pipeline?.cv_auc * 100 | number:'1.0-1'}}%
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-xs text-slate-400") 특징 수
                            p(class="mt-2 text-lg font-bold text-slate-900") {{prototypeInfo?.trained_model?.rf_pipeline?.feature_count || 13}}개
                    div(class="mt-5 grid gap-3 md:grid-cols-1", *ngIf="!prototypeInfo?.trained_model?.rf_pipeline?.metric_ready")
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-xs text-slate-400") 모델 정보
                            p(class="mt-2 text-sm text-slate-700") {{prototypeInfo?.trained_model?.rf_pipeline?.model_class || 'RandomForestClassifier'}} · 트리 {{prototypeInfo?.trained_model?.rf_pipeline?.n_estimators || 0}}개 · 특징 {{prototypeInfo?.trained_model?.rf_pipeline?.feature_count || 0}}개
                    div(class="mt-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3", *ngIf="prototypeInfo?.trained_model?.evaluation_source")
                        p(class="text-xs font-semibold text-slate-400") 검증 결과 ({{prototypeInfo?.trained_model?.evaluation_source}})
                        p(class="mt-2 text-sm text-slate-700") {{prototypeInfo?.trained_model?.evaluation_note}}

                div(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm")
                    h2(class="text-xl font-semibold text-slate-950") 영상 분석 진단
                    p(class="mt-3 text-sm leading-7 text-slate-600") {{prototypeInfo?.analysis_diagnostics?.headline}}
                    div(class="mt-5 space-y-3")
                        div(*ngFor="let item of prototypeInfo?.analysis_diagnostics?.items", class="rounded-2xl px-4 py-4", [ngClass]="diagnosticClass(item.severity)")
                            div(class="flex items-center justify-between gap-3")
                                p(class="text-sm font-semibold") {{item.title}}
                                span(class="inline-flex items-center rounded-full border border-current/10 px-2.5 py-1 text-[11px] font-semibold uppercase") {{item.severity}}
                            p(class="mt-2 text-sm leading-6") {{item.description}}
                            p(class="mt-2 text-xs leading-5 opacity-80") 조치: {{item.action}}

                div(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm")
                    h2(class="text-xl font-semibold text-slate-950") 관련 운영 정보
                    div(class="mt-5 grid gap-3")
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-sm font-medium text-slate-900") 분석 아카이브
                            p(class="mt-2 text-sm text-slate-700") 총 {{prototypeInfo?.analysis_archive_summary?.total || 0}}건 · 누적 {{prototypeInfo?.analysis_archive_summary?.total_duration_sec || 0}}초
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-sm font-medium text-slate-900") 학습 intake
                            p(class="mt-2 text-sm text-slate-700") Y {{prototypeInfo?.intake_summary?.Y || 0}}건 · N {{prototypeInfo?.intake_summary?.N || 0}}건 · 총 {{prototypeInfo?.intake_summary?.total || 0}}건
                        div(class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3")
                            p(class="text-sm font-medium text-slate-900") 라우팅 체크리스트
                            ul(class="mt-2 space-y-1")
                                li(*ngFor="let item of prototypeInfo?.routing_checklist", class="text-sm text-slate-700") • {{item}}

                div(class="rounded-3xl border border-rose-200 bg-rose-50 p-6 shadow-sm")
                    h2(class="text-xl font-semibold text-rose-950") 낙상 시 응급 프로토콜
                    p(class="mt-3 text-sm leading-7 text-rose-900") {{prototypeInfo?.emergency_protocol?.headline}}
                    div(class="mt-5 grid gap-3")
                        div(*ngFor="let protocol of prototypeInfo?.emergency_protocol?.levels", class="rounded-2xl border border-rose-200 bg-white px-4 py-4")
                            div(class="flex items-center justify-between gap-3")
                                p(class="text-sm font-semibold text-slate-900") {{protocol.label}}
                                span(class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", [ngClass]="statusBadgeClass(protocol.level === 'high' ? 'fallback' : 'preview')") {{protocol.level}}
                            p(class="mt-2 text-sm text-slate-700") {{protocol.trigger}}
                            ul(class="mt-3 space-y-1")
                                li(*ngFor="let step of protocol.steps", class="text-xs text-slate-600") • {{step}}
