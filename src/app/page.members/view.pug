div.w-full.h-full.overflow-auto
    div(class="max-w-5xl mx-auto py-8 px-6")

        //- 헤더
        div.flex.items-center.justify-between.mb-6
            div
                h1(class="text-lg font-bold text-slate-800 flex items-center gap-3")
                    div(class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-5 text-teal-500")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z")
                    span 멤버 관리

            div(class="flex items-center gap-2")
                button((click)="openInvite()",
                    class="inline-flex items-center px-4 py-2 bg-teal-600 text-white text-[13px] font-semibold rounded-lg hover:bg-teal-700 transition-colors shadow-sm")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4 mr-1")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z")
                    span 초대

        //- Role Filter
        div(class="flex flex-wrap items-center gap-2 mb-6")
            span(class="text-xs text-slate-400 mr-1") 역할:
            button((click)="filterByRole('')",
                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium transition-colors",
                [ngClass]="search.role === '' ? 'bg-teal-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'")
                | 전체
            button(*ngFor="let role of roles",
                (click)="filterByRole(role)",
                class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium capitalize transition-colors",
                [ngClass]="search.role === role ? 'bg-teal-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'")
                | {{role}}

        //- Members Grid
        ng-container(*ngIf="loading")
            div(class="text-center py-12 text-[13px] text-slate-400") 로딩 중...

        ng-container(*ngIf="!loading")
            div(*ngIf="members.length === 0", class="text-center py-12 text-[13px] text-slate-400") 멤버가 없습니다.

            div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4", *ngIf="members.length > 0")
                div(*ngFor="let member of members", class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 hover:shadow-md transition-shadow")
                    div(class="flex items-start justify-between")
                        div(class="flex items-center gap-3")
                            div(class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-lg text-sm font-bold", [ngClass]="member.avatarColor || 'bg-teal-50 text-teal-600'")
                                | {{member.name?.charAt(0) || '?'}}
                            div(class="min-w-0")
                                p(class="text-[13px] font-semibold text-slate-800 truncate") {{member.name}}
                                p(class="text-[11px] text-slate-400 truncate") {{member.email}}

                        span(class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium capitalize", [ngClass]="roleClass(member.role)")
                            | {{member.role}}

                    div(class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between")
                        span(class="text-[11px] text-slate-400") 가입일: {{member.joined}}
                        button((click)="removeMember(member); $event.stopPropagation()",
                            class="text-[11px] text-slate-400 hover:text-rose-500 transition-colors")
                            | 제거

//- Invite Modal
div(*ngIf="showInviteModal", class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm")
    div(class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden")
        div(class="px-6 py-5 border-b border-slate-100")
            h3(class="text-[15px] font-bold text-slate-800") 멤버 초대
            p(class="text-[13px] text-slate-400 mt-1") 이메일 주소로 새 멤버를 초대합니다.

        div(class="px-6 py-6 space-y-4")
            div
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 이메일
                input(type="email",
                    [(ngModel)]="inviteData.email",
                    placeholder="name@example.com",
                    class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")

            div
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 역할
                select([(ngModel)]="inviteData.role",
                    class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")
                    option(value="viewer") Viewer
                    option(value="editor") Editor
                    option(value="admin") Admin

        div(class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2")
            button((click)="showInviteModal = false",
                class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-[13px] font-medium text-slate-600 shadow-sm hover:bg-slate-50") 취소
            button((click)="invite()",
                class="inline-flex items-center rounded-lg bg-teal-600 px-4 py-2 text-[13px] font-semibold text-white shadow-sm hover:bg-teal-700") 초대
