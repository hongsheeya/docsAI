div.w-full.h-full.overflow-hidden(*ngIf="!loading")
    div.flex.flex-col.h-full
        //- 상단 헤더 + 스텝
        div(class="bg-white border-b border-slate-200 px-6 py-4 flex-shrink-0")
            div.flex.items-center.justify-between.mb-4
                div
                    h1(class="text-lg font-bold text-slate-800") {{ instance?.title }}
                    div(class="flex items-center gap-3 mt-1 text-xs text-slate-400")
                        span(*ngIf="instance?.week_label") 주차: {{ instance.week_label }}
                        span(*ngIf="instance?.folder_name") 폴더: {{ instance.folder_name }}
                        span 생성일: {{ instance?.created?.substring(0, 10) }}
                div(class="flex items-center gap-2")
                    button((click)="deleteDoc()",
                        class="px-3 py-1 text-[13px] border border-rose-200 text-rose-500 rounded-lg hover:bg-rose-50 transition-colors") 삭제
                    button((click)="service.href('/doc/write')",
                        class="px-3 py-1 text-[13px] border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 목록으로

            //- 스텝 네비게이션
            div(class="flex items-center gap-2")
                ng-container(*ngFor="let step of steps; let i = index; let last = last")
                    div(class="flex items-center gap-2 cursor-pointer",
                        (click)="goStep(step.key)")
                        div(class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-colors",
                            [ngClass]="{'bg-teal-600 text-white': isStepActive(step.key), 'bg-emerald-500 text-white': isStepDone(step.key), 'bg-slate-200 text-slate-400': !isStepActive(step.key) && !isStepDone(step.key)}")
                            | {{ step.number }}
                        span(class="text-[13px] font-medium",
                            [ngClass]="{'text-teal-600': isStepActive(step.key), 'text-emerald-700': isStepDone(step.key), 'text-slate-400': !isStepActive(step.key) && !isStepDone(step.key)}") {{ step.label }}
                    div(*ngIf="!last",
                        class="flex-1 h-px bg-slate-200 mx-2")

        //- 메인 콘텐츠 영역
        div(class="flex-1 min-h-0 overflow-auto")

            //- STEP 1: 설정
            div(*ngIf="tab === 'settings'",
                class="max-w-[1540px] mx-auto py-8 px-6 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_540px] gap-6 items-start")

                div(class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 xl:col-start-2 xl:row-start-1 xl:row-span-2 xl:sticky xl:top-6")
                    div(class="flex items-center justify-between gap-3 mb-4")
                        div
                            h2(class="text-[15px] font-semibold text-slate-800") 자료 미리보기
                            p(class="text-xs text-slate-400 mt-1") 기본 양식과 참고자료를 선택해서 확인합니다.
                        button(*ngIf="settingsPreviewOptions.length > 0",
                            type="button",
                            (click)="refreshSettingsPreviewUrl()",
                            class="px-3 py-1.5 text-xs border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 새로고침
                    select(*ngIf="settingsPreviewOptions.length > 0",
                        [(ngModel)]="settingsPreviewSource",
                        (change)="refreshSettingsPreviewUrl()",
                        class="w-full mb-3 border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                        option(*ngFor="let option of settingsPreviewOptions",
                            [value]="option.value") {{ option.label }}
                    div(*ngIf="settingsPreviewOptions.length > 0",
                        class="h-[720px] rounded-lg overflow-hidden border border-slate-200 bg-slate-100")
                        iframe(*ngIf="settingsPreviewUrl",
                            [src]="settingsPreviewUrl | safe:'resourceUrl'",
                            class="w-full h-full border-0 bg-white")
                        div(*ngIf="!settingsPreviewUrl",
                            class="h-full flex items-center justify-center text-[13px] text-slate-400") 미리보기를 준비 중입니다.
                    div(*ngIf="settingsPreviewOptions.length === 0",
                        class="rounded-lg border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-[13px] text-slate-400")
                        | 이 문서는 연결된 양식이나 참고자료가 없습니다.

                div(class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 xl:col-start-1 xl:row-start-1")
                    h2(class="text-[15px] font-semibold text-slate-800 mb-5") 기본 설정

                    div(*ngIf="instance?.content_json?.template_title",
                        class="mb-4 p-3 bg-teal-50 rounded-lg border border-teal-100")
                        div(class="text-xs text-slate-400") 사용 양식
                        div(class="text-[13px] font-medium text-slate-800 mt-1") {{ instance.content_json.template_title }}
                        div(*ngIf="instance?.content_json?.template_description",
                            class="text-xs text-slate-500 mt-2 whitespace-pre-wrap") {{ instance.content_json.template_description }}

                    div(class="grid grid-cols-2 gap-4 mb-4")
                        div
                            label(class="block text-[13px] font-medium text-slate-600 mb-1") 문서 제목
                            input(type="text",
                                [(ngModel)]="instance.title",
                                class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                        div
                            label(class="block text-[13px] font-medium text-slate-600 mb-1") 폴더
                            select([(ngModel)]="instance.folder_id",
                                class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                                option(value="") 미분류
                                option(*ngFor="let folder of folders", [value]="folder.id") {{ folder.name }}

                    div(class="grid grid-cols-3 gap-4 mb-4")
                        div
                            label(class="block text-[13px] font-medium text-slate-600 mb-1") 상태
                            select([(ngModel)]="instance.status",
                                class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                                option(value="draft") 초안
                                option(value="writing") 작성중
                                option(value="review") 검토
                                option(value="done") 완료
                        div
                            label(class="block text-[13px] font-medium text-slate-600 mb-1") 주차 라벨
                            input(type="text",
                                [(ngModel)]="settingsForm.week_label",
                                placeholder="예: 4월 3주차",
                                class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                        div
                            label(class="block text-[13px] font-medium text-slate-600 mb-1") 마감일
                            input(type="date",
                                [(ngModel)]="settingsForm.deadline",
                                class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")

                    div.mb-4
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 문서별 참고 설명
                        textarea([(ngModel)]="settingsForm.guide_notes",
                            placeholder="이번 문서의 주차/세부 상황/반드시 반영해야 할 참고사항을 입력하세요",
                            rows="4",
                            class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400 resize-none")
                        p(class="mt-1 text-xs text-slate-400") 양식 자체의 프로젝트 설명은 양식 관리 화면에서 설정하고, 여기는 이번 문서에만 필요한 설명을 적습니다.

                    div.mb-4
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 레포트 항목 구조
                        textarea([(ngModel)]="settingsForm.report_items_text",
                            placeholder="예: 연구 목적&#10;실험 조건&#10;Trapezoidal trajectory 입력 설정&#10;PID 제어 결과 분석&#10;오차 및 고찰&#10;결론",
                            rows="6",
                            class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400 resize-y")
                        p(class="mt-1 text-xs text-slate-400") 줄바꿈 기준으로 레포트 항목을 나누면, 주제가 바뀌어도 같은 구조로 문서를 생성합니다.

                    div.mb-4
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 참고자료 업로드 (선택)
                        div(class="border-2 border-dashed border-slate-300 rounded-lg p-4 text-center cursor-pointer hover:border-teal-400 transition-colors bg-slate-50",
                            (click)="refFileInput.click()")
                            input(#refFileInput="",
                                type="file",
                                multiple,
                                (change)="onRefFileSelect($event)",
                                class="hidden")
                            div(*ngIf="referenceFiles.length === 0",
                                class="text-[13px] text-slate-400") 참고할 파일을 선택하세요
                            div(*ngIf="referenceFiles.length > 0",
                                class="text-[13px] text-teal-600 font-medium") {{ referenceFiles.length }}개 파일 선택됨
                        div(*ngIf="referenceFiles.length > 0",
                            class="mt-2 flex flex-wrap gap-2")
                            span(*ngFor="let file of referenceFiles",
                                class="inline-flex items-center rounded-full bg-teal-50 px-2 py-1 text-xs text-teal-700") {{ file.name }}
                            button((click)="clearReferenceFiles()",
                                class="inline-flex items-center rounded-full border border-slate-300 px-2 py-1 text-xs text-slate-500 hover:bg-slate-50 transition-colors") 선택 해제
                        div(*ngIf="existingReferenceFiles.length > 0",
                            class="mt-2")
                            div(class="text-xs text-slate-400 mb-1") 저장된 참고자료
                            div(class="flex flex-wrap gap-2")
                                span(*ngFor="let ref of existingReferenceFiles",
                                    class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-600")
                                    span {{ ref.original_name || ref.filename }}
                                    button(type="button",
                                        (click)="removeExistingReferenceFile(ref)",
                                        class="ml-1 text-slate-400 hover:text-rose-500") 삭제

                    div.mb-4
                        div(class="flex items-center justify-between mb-2")
                            label(class="block text-[13px] font-medium text-slate-600") 이전 문서 참고 (선택)
                            span(class="text-xs text-slate-400") 선택한 문서의 말투와 구성 참고
                        div(*ngIf="referenceDocs.length === 0",
                            class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-[13px] text-slate-400") 참고 가능한 완료 문서가 없습니다.
                        div(*ngIf="referenceDocs.length > 0",
                            class="space-y-2 max-h-64 overflow-auto")
                            label(*ngFor="let doc of referenceDocs",
                                class="flex items-start gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 cursor-pointer hover:border-teal-300 transition-colors")
                                input(type="checkbox",
                                    [checked]="isReferenceDocSelected(doc.id)",
                                    (change)="toggleReferenceDoc(doc.id)",
                                    class="mt-1")
                                div(class="flex-1 min-w-0")
                                    div(class="flex items-center justify-between gap-3 mb-1")
                                        div(class="text-[13px] font-medium text-slate-800 truncate") {{ doc.title }}
                                        div(class="text-xs text-slate-400 whitespace-nowrap") {{ doc.created?.substring(0, 10) }}
                                    div(class="text-xs text-slate-400 mb-1")
                                        span 주차: {{ doc.week_label || '-' }}
                                        span(class="mx-2") ·
                                        span 섹션 {{ doc.section_count }}개
                                    div(class="text-xs text-slate-500 whitespace-pre-wrap line-clamp-3") {{ doc.preview || '미리보기 내용이 없습니다.' }}

                    //- AI 인스트럭션 선택
                    div.mb-4
                        div(class="flex items-center justify-between mb-2")
                            label(class="block text-[13px] font-medium text-slate-600") AI 인스트럭션 (선택)
                            span(class="text-xs text-slate-400") {{ selectedInstructionIds.length }}개 선택 · 활성 여부와 관계없이 선택 가능
                        div(class="mb-2 rounded-lg border border-violet-100 bg-violet-50 px-3 py-2 text-xs text-violet-700")
                            | 여기서 고른 인스트럭션만 이번 문서 작성 전에 적용됩니다. 활성화 상태는 기본값일 뿐, 선택을 막지 않습니다.
                        div(*ngIf="instructions.length === 0",
                            class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-[13px] text-slate-400") 등록된 인스트럭션이 없습니다. AI 설정에서 추가해보세요.
                        div(*ngIf="instructions.length > 0",
                            class="space-y-2 max-h-60 overflow-auto")
                            div(*ngFor="let inst of instructions",
                                class="flex items-start gap-3 rounded-lg border px-4 py-3 transition-colors",
                                [ngClass]="{'border-violet-300 bg-violet-50/50': isInstructionSelected(inst.id), 'border-slate-200 bg-slate-50 hover:border-violet-200': !isInstructionSelected(inst.id)}")
                                input(type="checkbox",
                                    [checked]="isInstructionSelected(inst.id)",
                                    (change)="toggleInstructionSelect(inst.id)",
                                    class="mt-1")
                                div(class="flex-1 min-w-0")
                                    div(class="flex items-center gap-2 flex-wrap")
                                        div(class="text-[13px] font-medium text-slate-800 truncate") {{ inst.title }}
                                        span(*ngIf="inst.user_id === 'system'",
                                            class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-500") 시스템
                                        span(*ngIf="inst.is_active",
                                            class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-50 text-emerald-600") 활성
                                        span(*ngIf="!inst.is_active",
                                            class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-500") 비활성 선택 가능
                                    div(class="text-xs text-slate-500 mt-1 line-clamp-2") {{ inst.content }}
                                button(type="button",
                                    (click)="toggleInstructionSelect(inst.id)",
                                    class="flex-shrink-0 px-3 py-1 text-xs rounded-lg border transition-colors",
                                    [ngClass]="{'border-violet-300 bg-violet-600 text-white': isInstructionSelected(inst.id), 'border-slate-300 bg-white text-slate-600 hover:border-violet-300': !isInstructionSelected(inst.id)}") {{ isInstructionSelected(inst.id) ? '해제' : '선택' }}

                div(class="flex justify-end gap-3 xl:col-start-1 xl:row-start-2")
                    button((click)="saveSettings()",
                        class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 transition-colors") 변경사항 저장
                    button((click)="goToGenerate()",
                        class="px-5 py-2 bg-teal-600 text-white text-[13px] font-semibold rounded-lg hover:bg-teal-700 transition-colors") 다음 → 양식 완성

            //- STEP 2: 자동 생성
            div(*ngIf="tab === 'generate'",
                class="max-w-3xl mx-auto py-8 px-6")

                div(class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6")
                    h2(class="text-[15px] font-semibold text-slate-800 mb-5") 양식 완성 / 내용 삽입
                    div(class="mb-4 rounded-lg border border-teal-100 bg-teal-50 px-4 py-3 text-[13px] text-teal-800")
                        | 원본 양식 파일을 복사한 뒤 기존 표, 여백, 글꼴 스타일은 유지하고 텍스트만 빈칸/필드에 삽입합니다. HWP/PDF는 변환본을 기준으로 같은 순서로 처리합니다.

                    div.mb-6
                        div(class="flex justify-between mb-2")
                            span(class="text-[13px] text-slate-600 font-medium") 진행률
                            span(class="text-[13px] text-slate-400") {{ generateProgress }}%
                        div(class="w-full h-2 bg-slate-200 rounded-full overflow-hidden")
                            div(class="h-full bg-teal-600 rounded-full transition-all duration-500",
                                [style.width.%]="generateProgress")

                    div(class="generate-log-container bg-slate-900 rounded-lg p-4 mb-6 max-h-96 overflow-auto")
                        div(*ngFor="let log of generateLogs; let i = index")
                            div(*ngIf="log.type === 'text'",
                                class="text-[12px] text-slate-300 font-mono leading-relaxed py-px") ▸ {{ log.message }}
                            div(*ngIf="log.type === 'section'",
                                class="text-[12px] text-emerald-400 font-mono leading-relaxed py-px") ✓ 섹션 완료: {{ log.title }}
                            div(*ngIf="log.type === 'detail'",
                                class="text-[12px] text-sky-300 font-mono leading-relaxed py-px") ℹ {{ log.message }}
                            div(*ngIf="log.type === 'error'",
                                class="text-[12px] text-rose-400 font-mono leading-relaxed py-px") ⚠ {{ log.message }}
                            div(*ngIf="log.type === 'prompt'",
                                class="my-1")
                                div(class="flex items-center gap-2 cursor-pointer text-[12px] font-mono text-blue-400 hover:text-blue-300 py-px",
                                    (click)="toggleLogExpand(i)")
                                    span {{ expandedLogIndices.has(i) ? '▾' : '▸' }}
                                    span [프롬프트] {{ log.title }}
                                div(*ngIf="expandedLogIndices.has(i)",
                                    class="ml-4 mt-1 p-3 bg-slate-800 rounded text-[11px] font-mono max-h-64 overflow-auto")
                                    div(class="text-amber-300 mb-1 font-semibold") ── System Prompt ──
                                    div(class="text-slate-400 whitespace-pre-wrap mb-3") {{ log.system }}
                                    div(class="text-amber-300 mb-1 font-semibold") ── User Prompt ──
                                    div(class="text-slate-400 whitespace-pre-wrap") {{ log.user }}
                            div(*ngIf="log.type === 'ai_response'",
                                class="my-1")
                                div(class="flex items-center gap-2 cursor-pointer text-[12px] font-mono text-violet-400 hover:text-violet-300 py-px",
                                    (click)="toggleLogExpand(i)")
                                    span {{ expandedLogIndices.has(i) ? '▾' : '▸' }}
                                    span [AI 응답] {{ log.title }}
                                div(*ngIf="expandedLogIndices.has(i)",
                                    class="ml-4 mt-1 p-3 bg-slate-800 rounded text-[11px] font-mono text-emerald-300 max-h-64 overflow-auto whitespace-pre-wrap") {{ log.content }}

                    div(*ngIf="followupQuestions.length > 0",
                        class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4")
                        h3(class="text-[13px] font-semibold text-amber-900 mb-2") 추가 정보가 있으면 양식 품질이 더 좋아집니다
                        p(class="text-xs text-amber-800 mb-3") 질문 버튼을 누르면 이 화면에서 바로 답변을 입력할 수 있습니다.
                        div(*ngIf="followupMissingFields.length > 0",
                            class="text-xs text-amber-800 mb-3")
                            | 현재 비어 있거나 추정이 어려운 항목: {{ followupMissingFields.join(', ') }}
                        div(class="space-y-2 mb-3")
                            button(*ngFor="let question of followupQuestions",
                                (click)="useFollowupQuestion(question)",
                                class="w-full text-left rounded-lg border border-amber-200 bg-white px-3 py-2 text-[13px] text-amber-900 hover:bg-amber-100 transition-colors")
                                div(class="flex items-start justify-between gap-3")
                                    span(class="flex-1 whitespace-normal") {{ question }}
                                    span(*ngIf="hasFollowupAnswer(question)",
                                        class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700") 답변 저장됨
                        div(*ngIf="activeFollowupQuestion",
                            class="mb-3 rounded-lg border border-amber-300 bg-white p-4")
                            div(class="text-xs text-slate-400 mb-1") 선택한 질문
                            div(class="text-[13px] font-medium text-amber-900 mb-3") {{ activeFollowupQuestion }}
                            textarea([(ngModel)]="followupAnswerDraft",
                                rows="4",
                                placeholder="여기에 바로 답변을 입력하세요. 저장되면 생성 참고 설명에 자동 반영됩니다.",
                                class="w-full border border-amber-200 rounded-lg px-3 py-2 text-[13px] text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-200 focus:border-amber-400 resize-y mb-3")
                            div(class="flex flex-wrap gap-2")
                                button((click)="saveFollowupAnswer()",
                                    [disabled]="followupAnswerSaving || !followupAnswerDraft.trim()",
                                    class="px-3 py-2 bg-amber-500 text-white text-xs font-medium rounded-lg hover:bg-amber-600 transition-colors disabled:opacity-50")
                                    span(*ngIf="!followupAnswerSaving") 답변 저장
                                    span(*ngIf="followupAnswerSaving") 저장 중...
                                button((click)="cancelFollowupAnswer()",
                                    class="px-3 py-2 border border-slate-300 text-slate-600 text-xs rounded-lg hover:bg-slate-50 transition-colors") 입력 닫기
                                button(*ngIf="!generating",
                                    (click)="saveFollowupAnswerAndRestart()",
                                    [disabled]="followupAnswerSaving || !followupAnswerDraft.trim()",
                                    class="px-3 py-2 border border-amber-300 text-amber-900 text-xs rounded-lg hover:bg-amber-100 transition-colors disabled:opacity-50") 답변 저장 후 다시 생성
                            div(*ngIf="generating",
                                class="mt-2 text-xs text-amber-800") 현재 생성 작업에는 일부만 반영될 수 있으며, 완료 후 다시 생성하면 전체 반영됩니다.
                        div(class="flex gap-2")
                            button((click)="goStep('settings')",
                                class="px-3 py-2 border border-amber-300 text-amber-900 text-xs rounded-lg hover:bg-amber-100 transition-colors") 설정으로 돌아가서 보충하기
                            button((click)="goToReviewChat()",
                                class="px-3 py-2 bg-amber-500 text-white text-xs font-medium rounded-lg hover:bg-amber-600 transition-colors") AI 채팅으로 답변하기

                    div.flex.justify-center.gap-3
                        button(*ngIf="!generating && generateProgress === 0",
                            (click)="startGenerate()",
                            class="px-6 py-2 bg-teal-600 text-white text-[13px] font-semibold rounded-lg hover:bg-teal-700 transition-colors") AI 생성 시작
                        button(*ngIf="generating",
                            disabled,
                            class="px-6 py-2 bg-slate-400 text-white text-[13px] font-medium rounded-lg opacity-70") 생성 중...
                        button(*ngIf="!generating && generateProgress >= 100",
                            (click)="goToReview()",
                            class="px-6 py-2 bg-emerald-500 text-white text-[13px] font-semibold rounded-lg hover:bg-emerald-600 transition-colors") 다음 → 검토/수정

            //- STEP 3: 검토/수정
            div(*ngIf="tab === 'review'",
                id="reviewSplitPane",
                class="h-full flex select-none")

                //- 좌측 — 미리보기
                div(class="border-r border-slate-200 bg-white flex flex-col min-w-0",
                    [style.width.%]="previewPanePercent")
                    //- 미리보기 헤더
                    div(class="flex items-center justify-between px-4 py-3 border-b border-slate-200 flex-shrink-0")
                        h3(class="text-[15px] font-semibold text-slate-800") 문서 미리보기
                        div.flex.items-center.gap-1
                            button((click)="refreshPreview()",
                                class="px-2 py-1 text-xs rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors mr-1") 새로고침
                            button((click)="togglePreviewMode('direct')",
                                class="px-2 py-1 text-xs rounded-lg transition-colors",
                                [ngClass]="{'bg-teal-600 text-white': previewMode === 'direct', 'bg-slate-100 text-slate-600 hover:bg-slate-200': previewMode !== 'direct'}") 직접
                            button((click)="togglePreviewMode('pdf')",
                                class="px-2 py-1 text-xs rounded-lg transition-colors",
                                [ngClass]="{'bg-teal-600 text-white': previewMode === 'pdf', 'bg-slate-100 text-slate-600 hover:bg-slate-200': previewMode !== 'pdf'}") PDF
                            button((click)="togglePreviewMode('text')",
                                class="px-2 py-1 text-xs rounded-lg transition-colors",
                                [ngClass]="{'bg-teal-600 text-white': previewMode === 'text', 'bg-slate-100 text-slate-600 hover:bg-slate-200': previewMode !== 'text'}") 텍스트

                    //- 텍스트 미리보기
                    div(*ngIf="previewMode === 'text'",
                        class="flex-1 min-h-0 overflow-auto p-6")
                        div(*ngIf="sections.length === 0",
                            class="text-center py-12 text-[13px] text-slate-400") 생성된 섹션이 없습니다
                        div(*ngFor="let sec of sections",
                            class="mb-6")
                            h4(class="text-[14px] font-semibold text-slate-800 mb-2 pb-1 border-b border-slate-200") {{ sec.section_title }}
                            div(class="text-[13px] text-slate-600 whitespace-pre-wrap leading-relaxed") {{ sec.content }}

                    //- 직접 편집
                    div(*ngIf="previewMode === 'direct'",
                        class="flex-1 min-h-0")
                        iframe(*ngIf="directEditorUrl",
                            [src]="directEditorUrl | safe:'resourceUrl'",
                            class="w-full h-full border-0")
                        div(*ngIf="!directEditorUrl",
                            class="flex items-center justify-center h-full text-[13px] text-slate-400") 직접 편집기를 로드합니다...

                    //- PDF 미리보기
                    div(*ngIf="previewMode === 'pdf'",
                        class="flex-1 min-h-0")
                        iframe(*ngIf="pdfPreviewUrl",
                            [src]="pdfPreviewUrl | safe:'resourceUrl'",
                            class="w-full h-full border-0")
                        div(*ngIf="!pdfPreviewUrl",
                            class="flex items-center justify-center h-full text-[13px] text-slate-400") PDF를 로드합니다...

                //- 우측 — 탭
                div((mousedown)="startReviewPaneResize($event)",
                    class="w-1.5 flex-shrink-0 cursor-col-resize bg-slate-100 hover:bg-teal-300 transition-colors")
                div(class="flex flex-col min-w-[280px]",
                    [style.width.%]="100 - previewPanePercent")
                    //- 탭 헤더
                    div(class="flex border-b border-slate-200 bg-white px-4 flex-shrink-0")
                        button(*ngFor="let rt of ['overview', 'fields', 'chat', 'sections', 'images']",
                            (click)="reviewTab = rt; service.render()",
                            class="px-4 py-3 text-[13px] font-medium border-b-2 transition-colors",
                            [ngClass]="{'border-teal-500 text-teal-600': reviewTab === rt, 'border-transparent text-slate-400': reviewTab !== rt}")
                            span(*ngIf="rt === 'overview'") 개요
                            span(*ngIf="rt === 'fields'") 양식 편집
                            span(*ngIf="rt === 'chat'") AI 채팅
                            span(*ngIf="rt === 'sections'") 섹션 편집
                            span(*ngIf="rt === 'images'") 이미지/그래프

                    //- 탭 콘텐츠
                    div(class="flex-1 min-h-0 overflow-auto p-4")

                        //- 개요
                        div(*ngIf="reviewTab === 'overview'")
                            div(class="bg-white rounded-lg border border-slate-200 p-4 mb-4")
                                h4(class="text-[13px] font-semibold text-slate-800 mb-3") 문서 정보
                                div(class="space-y-2 text-[13px]")
                                    div.flex.justify-between
                                        span.text-slate-400 제목
                                        span(class="font-medium text-slate-800") {{ instance?.title }}
                                    div.flex.justify-between
                                        span.text-slate-400 폴더
                                        span.text-slate-800 {{ instance?.folder_name || '미분류' }}
                                    div.flex.justify-between
                                        span.text-slate-400 상태
                                        span.text-slate-800 {{ instance?.status }}
                                    div.flex.justify-between
                                        span.text-slate-400 섹션 수
                                        span.text-slate-800 {{ sections.length }}개
                                    div(*ngIf="instance?.content_json?.generated_fields",
                                        class="flex justify-between")
                                        span.text-slate-400 채워진 항목 수
                                        span.text-slate-800 {{ (instance.content_json.generated_fields | keyvalue).length }}개
                                    div(*ngIf="instance?.week_label",
                                        class="flex justify-between")
                                        span.text-slate-400 주차
                                        span.text-slate-800 {{ instance.week_label }}

                            //- 다운로드 버튼
                            div(class="bg-white rounded-lg border border-slate-200 p-4 mb-4")
                                h4(class="text-[13px] font-semibold text-slate-800 mb-3") 문서 다운로드
                                div.flex.gap-3.mb-2
                                    button((click)="downloadPdf()",
                                        [disabled]="downloadingPdf",
                                        class="flex-1 px-4 py-2 bg-rose-500 text-white text-[13px] font-medium rounded-lg hover:bg-rose-600 text-center transition-colors disabled:opacity-50")
                                        span(*ngIf="!downloadingPdf") PDF 다운로드
                                        span(*ngIf="downloadingPdf") 생성 중...
                                    button((click)="downloadDocx()",
                                        [disabled]="downloadingDocx",
                                        class="flex-1 px-4 py-2 bg-blue-500 text-white text-[13px] font-medium rounded-lg hover:bg-blue-600 text-center transition-colors disabled:opacity-50")
                                        span(*ngIf="!downloadingDocx") 편집용 DOCX
                                        span(*ngIf="downloadingDocx") 생성 중...
                                div.flex.gap-3
                                    button((click)="downloadHwp()",
                                        [disabled]="downloadingHwp",
                                        class="flex-1 px-4 py-2 bg-emerald-500 text-white text-[13px] font-medium rounded-lg hover:bg-emerald-600 text-center transition-colors disabled:opacity-50")
                                        span(*ngIf="!downloadingHwp") HWPX 다운로드
                                        span(*ngIf="downloadingHwp") 생성 중...

                            div.flex.gap-3
                                button((click)="service.href('/doc/write')",
                                    class="flex-1 px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 text-center transition-colors") 목록으로

                        //- AI 채팅
                        div(*ngIf="reviewTab === 'chat'",
                            class="flex flex-col h-full")

                            //- 섹션 컨텍스트 배너
                            div(*ngIf="chatContextSection",
                                class="flex items-center justify-between bg-teal-50 border border-teal-200 rounded-lg px-3 py-2 mb-3 flex-shrink-0")
                                div(class="text-xs text-teal-700")
                                    span.font-medium 컨텍스트:
                                    |  {{ chatContextSection.section_title }}
                                button((click)="clearChatContext()",
                                    class="text-xs text-teal-400 hover:text-teal-600") ✕ 해제

                            //- 섹션 선택 바
                            div(*ngIf="sections.length > 0",
                                class="flex flex-wrap gap-1 mb-3 flex-shrink-0")
                                button(*ngFor="let sec of sections",
                                    (click)="setChatContext(sec)",
                                    class="px-2 py-1 text-xs rounded-lg border transition-colors",
                                    [ngClass]="{'bg-teal-600 text-white border-teal-600': chatContextSection?.id === sec.id, 'bg-white text-slate-500 border-slate-200 hover:border-teal-300': chatContextSection?.id !== sec.id}") {{ sec.section_title }}

                            //- 대화 영역
                            div(class="flex-1 min-h-0 overflow-auto space-y-3 mb-3")
                                div(*ngIf="chatMessages.length === 0",
                                    class="text-center py-8 text-[13px] text-slate-400") AI에게 문서 수정을 요청해보세요.
                                div(*ngFor="let msg of chatMessages",
                                    class="flex",
                                    [class.justify-end]="msg.role === 'user'")
                                    div(class="px-3 py-2 rounded-xl text-[13px]",
                                        [ngClass]="{'bg-teal-600 text-white': msg.role === 'user', 'bg-white text-slate-700 border border-slate-200': msg.role === 'assistant'}",
                                        class="max-w-[80%] whitespace-pre-wrap")
                                        | {{ msg.content }}
                                div(*ngIf="chatLoading",
                                    class="flex")
                                    div(class="bg-white border border-slate-200 px-3 py-2 rounded-xl text-[13px] text-slate-400") AI가 응답 중...

                            //- 빠른 프롬프트 버튼
                            div(class="flex flex-wrap gap-1 mb-2 flex-shrink-0")
                                button(*ngFor="let qp of quickPrompts",
                                    (click)="useQuickPrompt(qp)",
                                    [disabled]="chatLoading",
                                    class="px-2 py-1 text-xs bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition-colors disabled:opacity-50") {{ qp }}

                            //- 이미지 첨부 미리보기
                            div(*ngIf="chatImageFile",
                                class="flex items-center gap-2 mb-2 px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg flex-shrink-0")
                                div(class="w-8 h-8 rounded bg-slate-200 flex items-center justify-center text-slate-400 text-xs") 📎
                                div(class="flex-1 min-w-0")
                                    div(class="text-xs text-slate-600 truncate") {{ chatImageFile.name }}
                                    div(class="text-[10px] text-slate-400") {{ (chatImageFile.size / 1024).toFixed(1) }}KB
                                button((click)="clearChatImage()",
                                    class="text-xs text-slate-400 hover:text-rose-500") ✕

                            //- 입력 영역
                            div(class="flex gap-2 flex-shrink-0")
                                //- 이미지 첨부 버튼
                                button((click)="chatImageInput.click()",
                                    class="px-2 py-2 border border-slate-300 text-slate-500 rounded-lg hover:bg-slate-50 hover:text-teal-600 transition-colors",
                                    title="파일 첨부 (이미지, CSV, PDF, DOCX, HWP)")
                                    span(class="text-[15px]") 📎
                                input(#chatImageInput="",
                                    type="file",
                                    accept="image/*,.csv,text/csv,.pdf,.docx,.doc,.hwp,.hwpx",
                                    (change)="onChatImageSelect($event)",
                                    class="hidden")
                                input(type="text",
                                    [(ngModel)]="chatInput",
                                    (compositionstart)="onChatCompositionStart()",
                                    (compositionend)="onChatCompositionEnd($event)",
                                    (keydown)="onChatKeydown($event)",
                                    placeholder="수정 요청을 입력하세요...",
                                    class="flex-1 border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                                button((click)="sendChat()",
                                    [disabled]="chatLoading",
                                    class="px-4 py-2 bg-teal-600 text-white text-[13px] font-semibold rounded-lg hover:bg-teal-700 transition-colors disabled:opacity-50") 전송

                        //- 양식 편집 (서두/본문/결론 구획화)
                        div(*ngIf="reviewTab === 'fields'")
                            //- 데이터 없음
                            div(*ngIf="fieldGroups.length === 0",
                                class="text-center py-8 text-[13px] text-slate-400") AI 생성 후 양식 편집이 가능합니다

                            //- 구획별 그룹
                            div(*ngFor="let group of fieldGroups",
                                class="bg-white rounded-lg border border-slate-200 mb-4 overflow-hidden")
                                //- 그룹 헤더
                                div(class="flex items-center gap-2 px-4 py-2 border-b border-slate-100",
                                    [ngClass]="{'bg-sky-50': group.groupType === '서두', 'bg-teal-50': group.groupType === '본문', 'bg-amber-50': group.groupType === '결론', 'bg-slate-50': group.groupType === '기타'}")
                                    span(class="text-[13px] font-semibold",
                                        [ngClass]="{'text-sky-700': group.groupType === '서두', 'text-teal-700': group.groupType === '본문', 'text-amber-700': group.groupType === '결론', 'text-slate-600': group.groupType === '기타'}") {{ group.groupType }}
                                    span(class="text-xs text-slate-400") {{ group.fields.length }}개 항목

                                //- 필드 목록
                                div(class="divide-y divide-slate-100")
                                    div(*ngFor="let field of group.fields",
                                        class="px-4 py-3")
                                        //- 보기 모드
                                        div(*ngIf="editingFieldLabel !== field.label")
                                            div.flex.items-start.justify-between.gap-2
                                                div(class="flex-1 min-w-0")
                                                    div(class="text-xs font-medium text-slate-500 mb-1") {{ field.label }}
                                                    div(class="text-[13px] text-slate-800 whitespace-pre-wrap leading-relaxed max-h-28 overflow-auto",
                                                        [ngClass]="{'text-slate-300 italic': !field.value}") {{ field.value || '(미입력)' }}
                                                div(class="flex flex-shrink-0 gap-1")
                                                    input(#fieldImageInput="",
                                                        type="file",
                                                        accept="image/*",
                                                        (change)="insertImageForField(field, $event)",
                                                        class="hidden")
                                                    button((click)="fieldImageInput.click()",
                                                        [disabled]="fieldImageUploadingLabel === field.label",
                                                        class="px-2 py-1 text-xs border border-teal-200 text-teal-600 rounded-lg hover:bg-teal-50 transition-colors disabled:opacity-50") {{ fieldImageUploadingLabel === field.label ? '삽입 중' : '사진 삽입' }}
                                                    button((click)="startFieldEdit(field.label, field.value, field.style); service.render()",
                                                        class="px-2 py-1 text-xs border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 편집

                                        //- 편집 모드
                                        div(*ngIf="editingFieldLabel === field.label")
                                            div(class="text-xs font-medium text-slate-500 mb-1") {{ field.label }}
                                            textarea([(ngModel)]="editingFieldValue",
                                                rows="4",
                                                class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400 resize-y mb-2",
                                                style="min-height:80px;")
                                            div(class="grid grid-cols-2 gap-2 mb-2")
                                                div
                                                    label(class="block text-[11px] text-slate-400 mb-1") 글꼴
                                                    select([(ngModel)]="editingFieldStyle.font_family",
                                                        class="w-full border border-slate-300 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-200")
                                                        option(value="gothic") 고딕
                                                        option(value="myeongjo") 명조
                                                        option(value="batang") 바탕
                                                        option(value="mono") 고정폭
                                                div
                                                    label(class="block text-[11px] text-slate-400 mb-1") 크기(pt)
                                                    input(type="number",
                                                        min="5",
                                                        max="28",
                                                        step="0.5",
                                                        [(ngModel)]="editingFieldStyle.font_size",
                                                        class="w-full border border-slate-300 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-200")
                                                div
                                                    label(class="block text-[11px] text-slate-400 mb-1") 정렬
                                                    select([(ngModel)]="editingFieldStyle.align",
                                                        class="w-full border border-slate-300 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-200")
                                                        option(value="left") 왼쪽
                                                        option(value="center") 가운데
                                                        option(value="right") 오른쪽
                                                div
                                                    label(class="block text-[11px] text-slate-400 mb-1") 색상
                                                    input(type="color",
                                                        [(ngModel)]="editingFieldStyle.color",
                                                        class="w-full h-8 border border-slate-300 rounded-lg px-1 py-1")
                                            label(class="inline-flex items-center gap-2 text-xs text-slate-600 mb-2")
                                                input(type="checkbox",
                                                    [(ngModel)]="editingFieldStyle.bold")
                                                span 굵게
                                            div.flex.justify-end.gap-2
                                                input(#editFieldImageInput="",
                                                    type="file",
                                                    accept="image/*",
                                                    (change)="insertImageForField(field, $event)",
                                                    class="hidden")
                                                button((click)="editFieldImageInput.click()",
                                                    [disabled]="fieldImageUploadingLabel === field.label",
                                                    class="px-3 py-1 text-xs border border-teal-200 text-teal-600 rounded-lg hover:bg-teal-50 transition-colors disabled:opacity-50") {{ fieldImageUploadingLabel === field.label ? '삽입 중' : '사진 삽입' }}
                                                button((click)="cancelFieldEdit(); service.render()",
                                                    class="px-3 py-1 text-xs border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 취소
                                                button((click)="saveFieldEdit()",
                                                    class="px-3 py-1 text-xs bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors") 저장

                            //- 재생성 버튼
                            div(*ngIf="fieldGroups.length > 0",
                                class="bg-white rounded-lg border border-slate-200 p-4")
                                div(class="text-xs text-slate-400 mb-3") 값을 수정한 뒤 아래 버튼으로 문서를 다시 생성합니다.
                                div(*ngFor="let log of regenOutputLogs",
                                    class="text-xs text-slate-500 mb-1") {{ log }}
                                button((click)="regenOutput()",
                                    [disabled]="regenOutputLoading",
                                    class="w-full py-2 bg-teal-600 text-white text-[13px] font-semibold rounded-lg hover:bg-teal-700 transition-colors disabled:opacity-50")
                                    span(*ngIf="!regenOutputLoading") 수정 내용으로 문서 재생성
                                    span(*ngIf="regenOutputLoading") 재생성 중...

                        //- 섹션 편집
                        div(*ngIf="reviewTab === 'sections'")
                            div(*ngIf="sections.length === 0",
                                class="text-center py-8 text-[13px] text-slate-400") 생성된 섹션이 없습니다

                            div(*ngFor="let sec of sections",
                                class="bg-white rounded-lg border border-slate-200 p-4 mb-3")
                                div.flex.items-center.justify-between.mb-2
                                    div.flex.items-center.gap-2
                                        span(class="text-[13px] font-semibold text-slate-800") {{ sec.section_title }}
                                        span(class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium",
                                            [ngClass]="sectionStatusClass(sec.status)") {{ sectionStatusLabel(sec.status) }}
                                    div.flex.items-center.gap-1
                                        button((click)="showInlineEdit(sec)",
                                            [disabled]="sec._regenerating",
                                            class="px-2 py-1 text-xs border border-violet-200 text-violet-600 rounded-lg hover:bg-violet-50 transition-colors disabled:opacity-50") AI 수정
                                        button((click)="regenerateSection(sec)",
                                            [disabled]="sec._regenerating",
                                            class="px-2 py-1 text-xs border border-amber-200 text-amber-600 rounded-lg hover:bg-amber-50 transition-colors disabled:opacity-50")
                                            span(*ngIf="!sec._regenerating") 재작성
                                            span(*ngIf="sec._regenerating") 재작성 중...
                                        button(*ngIf="editingSection?.id !== sec.id",
                                            (click)="startEditSection(sec)",
                                            class="px-2 py-1 text-xs border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 편집

                                //- 인라인 AI 수정 요청
                                div(*ngIf="inlineEditSectionId === sec.id",
                                    class="mb-3 p-3 bg-violet-50 border border-violet-200 rounded-lg")
                                    div(class="text-xs text-violet-700 font-medium mb-2") AI에게 수정 요청
                                    input(type="text",
                                        [(ngModel)]="inlineEditInstruction",
                                        (keydown.enter)="submitInlineEdit(sec)",
                                        placeholder="예: 더 전문적으로 작성해줘, 데이터를 추가해줘",
                                        class="w-full border border-violet-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-violet-200 focus:border-violet-400 mb-2")
                                    div.flex.justify-end.gap-2
                                        button((click)="cancelInlineEdit()",
                                            class="px-3 py-1 text-xs border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 취소
                                        button((click)="submitInlineEdit(sec)",
                                            [disabled]="inlineEditLoading",
                                            class="px-3 py-1 text-xs bg-violet-500 text-white rounded-lg hover:bg-violet-600 transition-colors disabled:opacity-50")
                                            span(*ngIf="!inlineEditLoading") AI 수정 요청
                                            span(*ngIf="inlineEditLoading") 수정 중...

                                //- 보기 모드
                                div(*ngIf="editingSection?.id !== sec.id",
                                    class="text-[13px] text-slate-600 whitespace-pre-wrap leading-relaxed max-h-40 overflow-auto") {{ sec.content || '(내용 없음)' }}

                                //- 편집 모드 (Task 6: 더 크게 + 리사이즈 가능)
                                div(*ngIf="editingSection?.id === sec.id")
                                    textarea([(ngModel)]="editContent",
                                        rows="12",
                                        class="w-full border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400 resize-y mb-2",
                                        style="min-height: 200px;")
                                    div.flex.justify-end.gap-2
                                        button((click)="cancelEdit()",
                                            class="px-3 py-1 text-xs border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors") 취소
                                        button((click)="saveSection()",
                                            class="px-3 py-1 text-xs bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors") 저장

                        //- 이미지/그래프
                        div(*ngIf="reviewTab === 'images'")

                            //- 이미지 업로드
                            div(class="bg-white rounded-lg border border-slate-200 p-4 mb-4")
                                h4(class="text-[13px] font-semibold text-slate-800 mb-3") 이미지 업로드
                                div(class="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center cursor-pointer hover:border-teal-400 transition-colors bg-slate-50",
                                    [ngClass]="{'opacity-50 pointer-events-none': uploadingImage}",
                                    (click)="imgUploadInput.click()")
                                    input(#imgUploadInput="",
                                        type="file",
                                        accept="image/*",
                                        (change)="onImageUpload($event)",
                                        class="hidden")
                                    div(*ngIf="!uploadingImage",
                                        class="text-[13px] text-slate-400")
                                        div(class="mb-1 text-slate-500") 클릭하여 이미지를 업로드하세요
                                        div(class="text-xs") PNG, JPG, GIF 등
                                    div(*ngIf="uploadingImage",
                                        class="text-[13px] text-teal-600 font-medium") 업로드 중...

                            //- AI 그래프 생성
                            div(class="bg-white rounded-lg border border-slate-200 p-4 mb-4")
                                h4(class="text-[13px] font-semibold text-slate-800 mb-3") AI 그래프 생성
                                div(class="text-xs text-slate-400 mb-3") AI에게 원하는 그래프를 설명하면 자동으로 생성됩니다.
                                div.flex.gap-2
                                    input(type="text",
                                        [(ngModel)]="chartPrompt",
                                        (keydown.enter)="generateChart()",
                                        placeholder="예: 월별 매출 추이를 보여주는 막대그래프를 만들어줘",
                                        class="flex-1 border border-slate-300 rounded-lg px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-400")
                                    button((click)="generateChart()",
                                        [disabled]="chartGenerating",
                                        class="px-4 py-2 bg-teal-600 text-white text-[13px] font-semibold rounded-lg hover:bg-teal-700 transition-colors whitespace-nowrap disabled:opacity-50")
                                        span(*ngIf="!chartGenerating") 생성
                                        span(*ngIf="chartGenerating") 생성 중...
                                    button((click)="chartCsvInput.click()",
                                        [disabled]="chartGenerating",
                                        class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] font-medium rounded-lg hover:bg-slate-50 transition-colors whitespace-nowrap disabled:opacity-50") CSV 선택
                                    input(#chartCsvInput="",
                                        type="file",
                                        accept=".csv,text/csv",
                                        (change)="onChartCsvSelect($event)",
                                        class="hidden")
                                div(*ngIf="chartCsvFile",
                                    class="mt-3 flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2")
                                    div(class="w-8 h-8 rounded bg-slate-200 flex items-center justify-center text-slate-400 text-xs") CSV
                                    div(class="flex-1 min-w-0")
                                        div(class="text-xs text-slate-700 truncate") {{ chartCsvFile.name }}
                                        div(class="text-[10px] text-slate-400") 업로드한 CSV를 기준으로 MATLAB 스타일 그래프를 생성합니다.
                                    button((click)="clearChartCsv()",
                                        class="text-xs text-slate-400 hover:text-rose-500") ✕
                                div(class="mt-2 text-[11px] text-slate-400") CSV를 선택하면 첫 열을 X축으로, 숫자 열들을 Y축 시리즈로 해석해 실험 그래프를 자동 생성합니다. 프롬프트에 line/bar/scatter 같은 키워드를 함께 적을 수 있습니다.

                            //- 이미지 갤러리 + 배치
                            div(class="bg-white rounded-lg border border-slate-200 p-4")
                                div.flex.items-center.justify-between.mb-3
                                    h4(class="text-[13px] font-semibold text-slate-800") 이미지 목록
                                    span(class="text-xs text-slate-400") {{ images.length }}개

                                div(*ngIf="images.length === 0",
                                    class="text-center py-8 text-[13px] text-slate-400") 업로드된 이미지가 없습니다

                                div(*ngIf="images.length > 0",
                                    class="space-y-3")
                                    div(*ngFor="let img of images",
                                        class="border border-slate-200 rounded-lg overflow-hidden")
                                        div(class="flex gap-3 p-3")
                                            //- 이미지 썸네일
                                            img([src]="getImageUrl(img)",
                                                [alt]="img.filename",
                                                class="w-24 h-20 object-cover rounded-lg flex-shrink-0")
                                            div(class="flex-1 min-w-0")
                                                div(class="text-[13px] text-slate-700 truncate mb-1") {{ img.filename }}
                                                //- 현재 배치 상태
                                                div(*ngIf="getImagePlacement(img.filename)",
                                                    class="flex items-center gap-2 mb-2")
                                                    span(class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-teal-100 text-teal-700") 📍 {{ getImagePlacement(img.filename) }}
                                                    button((click)="unplaceImage(img)",
                                                        class="text-[10px] text-slate-400 hover:text-rose-500") 배치 해제
                                                //- 배치 안 된 경우 — 위치 선택
                                                div(*ngIf="!getImagePlacement(img.filename) && imagePositions.length > 0",
                                                    class="mb-2")
                                                    div(class="grid grid-cols-[minmax(0,1fr)_112px_56px] gap-2")
                                                        select(#posSelect="",
                                                            class="border border-slate-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-200")
                                                            option(value="") 위치 선택...
                                                            option(*ngFor="let pos of imagePositions", [value]="pos") {{ pos }}
                                                        select(#modeSelect="",
                                                            class="border border-slate-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-200")
                                                            option(value="below") 텍스트 아래
                                                            option(value="above") 텍스트 위
                                                            option(value="only") 칸 교체
                                                        button((click)="placeImage(img, posSelect.value, modeSelect.value)",
                                                            class="px-2 py-1 text-xs bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors whitespace-nowrap") 삽입
                                                //- 직접 좌표 배치
                                                div(class="mt-2 rounded-lg border border-slate-200 bg-slate-50 p-2")
                                                    div(class="text-[11px] font-medium text-slate-500 mb-2") 직접 위치
                                                    div(class="grid grid-cols-5 gap-1 mb-2")
                                                        input(type="number",
                                                            min="1",
                                                            [(ngModel)]="getImageDraft(img.filename).page",
                                                            title="페이지",
                                                            class="border border-slate-200 rounded px-1 py-1 text-[11px]")
                                                        input(type="number",
                                                            min="0",
                                                            max="95",
                                                            step="0.5",
                                                            [(ngModel)]="getImageDraft(img.filename).x_pct",
                                                            title="X%",
                                                            class="border border-slate-200 rounded px-1 py-1 text-[11px]")
                                                        input(type="number",
                                                            min="0",
                                                            max="95",
                                                            step="0.5",
                                                            [(ngModel)]="getImageDraft(img.filename).y_pct",
                                                            title="Y%",
                                                            class="border border-slate-200 rounded px-1 py-1 text-[11px]")
                                                        input(type="number",
                                                            min="1",
                                                            max="100",
                                                            step="0.5",
                                                            [(ngModel)]="getImageDraft(img.filename).w_pct",
                                                            title="W%",
                                                            class="border border-slate-200 rounded px-1 py-1 text-[11px]")
                                                        input(type="number",
                                                            min="1",
                                                            max="100",
                                                            step="0.5",
                                                            [(ngModel)]="getImageDraft(img.filename).h_pct",
                                                            title="H%",
                                                            class="border border-slate-200 rounded px-1 py-1 text-[11px]")
                                                    div(class="flex items-center justify-between gap-2")
                                                        div(class="text-[10px] text-slate-400") 페이지 · X% · Y% · W% · H%
                                                        button((click)="placeImageAbsolute(img)",
                                                            class="px-2 py-1 text-xs bg-slate-900 text-white rounded-lg hover:bg-slate-700 transition-colors whitespace-nowrap") 직접 삽입
                                                //- 삭제
                                                div(class="flex gap-1")
                                                    button((click)="deleteImage(img)",
                                                        class="px-2 py-1 text-xs border border-rose-200 text-rose-500 rounded-lg hover:bg-rose-50 transition-colors") 삭제
