div.w-full.h-full.overflow-auto
    div(class="max-w-3xl mx-auto py-8 px-6")
        //- 헤더
        div.flex.items-center.gap-3.mb-6
            div(class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-5 text-teal-500")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z")
            h1(class="text-lg font-bold text-slate-800") 내 프로필

    ng-container(*ngIf="user")
        div(class="max-w-3xl mx-auto px-6 pb-12 space-y-6")
            //- Profile Section
            div(class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden")
                div(class="px-6 py-5 border-b border-slate-100")
                    h2(class="text-[15px] font-semibold text-slate-800") 개인정보
                    p(class="mt-1 text-[13px] text-slate-400") 기본 프로필 정보를 수정할 수 있습니다.

                div(class="px-6 py-6 space-y-5")
                    //- Avatar
                    div(class="flex items-center gap-x-4 pb-2")
                        div(class="flex items-center justify-center w-14 h-14 rounded-xl bg-teal-600 text-white text-xl font-bold")
                            | {{user.name?.charAt(0) || '?'}}
                        div
                            p(class="text-[13px] font-semibold text-slate-800") {{user.name}}
                            p(class="text-[13px] text-slate-400") {{user.email}}
                            span(class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium mt-1",
                                [ngClass]="user.role === 'admin' ? 'bg-violet-50 text-violet-700' : 'bg-blue-50 text-blue-700'")
                                | {{user.role}}

                    //- Email (readonly)
                    div
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 이메일
                        input(type="email", [value]="user.email", disabled, class="block w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-[13px] text-slate-400")

                    //- Name
                    div
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 이름
                        input(type="text", [(ngModel)]="user.name", class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")

                    //- Mobile
                    div
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 연락처
                        input(type="text", [(ngModel)]="user.mobile", placeholder="010-0000-0000", class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")

                div(class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end")
                    button((click)="updateProfile()",
                        [disabled]="saving",
                        class="inline-flex items-center rounded-lg bg-teal-600 px-4 py-2 text-[13px] font-semibold text-white shadow-sm hover:bg-teal-700 disabled:opacity-50")
                        svg(class="animate-spin size-4 mr-2", viewBox="0 0 24 24", *ngIf="saving")
                            circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4")
                            path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")
                        | 저장

            //- Password Section
            div(class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden")
                div(class="px-6 py-5 border-b border-slate-100")
                    h2(class="text-[15px] font-semibold text-slate-800") 비밀번호 변경
                    p(class="mt-1 text-[13px] text-slate-400") 보안을 위해 주기적으로 비밀번호를 변경해주세요.

                div(class="px-6 py-6 space-y-5")
                    div
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 현재 비밀번호
                        input(type="password", [(ngModel)]="passwordForm.current_password", placeholder="현재 비밀번호 입력", class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")

                    div
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 새 비밀번호
                        input(type="password", [(ngModel)]="passwordForm.new_password", placeholder="8자 이상 입력", class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")

                    div
                        label(class="block text-[13px] font-medium text-slate-600 mb-1") 새 비밀번호 확인
                        input(type="password", [(ngModel)]="passwordForm.confirm_password", placeholder="새 비밀번호 다시 입력", class="block w-full rounded-lg border border-slate-300 px-3 py-2 text-[13px] text-slate-800 focus:border-teal-400 focus:ring-2 focus:ring-teal-200 focus:outline-none")

                div(class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end")
                    button((click)="changePassword()",
                        [disabled]="changingPassword",
                        class="inline-flex items-center rounded-lg bg-rose-500 px-4 py-2 text-[13px] font-semibold text-white shadow-sm hover:bg-rose-600 disabled:opacity-50")
                        svg(class="animate-spin size-4 mr-2", viewBox="0 0 24 24", *ngIf="changingPassword")
                            circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4")
                            path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z")
                        | 비밀번호 변경
