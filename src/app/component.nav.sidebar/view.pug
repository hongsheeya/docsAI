div(class="flex shrink-0 items-center justify-center pt-5 pb-4")
    div(routerLink="/", class="flex items-center gap-2 cursor-pointer")
        div(class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-600 text-white")
            svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-5")
                path(stroke-linecap="round", stroke-linejoin="round", d="M3 7.5h18M6.75 3.75h10.5A2.25 2.25 0 0 1 19.5 6v12A2.25 2.25 0 0 1 17.25 20.25H6.75A2.25 2.25 0 0 1 4.5 18V6a2.25 2.25 0 0 1 2.25-2.25Zm1.5 8.25 2.25 2.25 4.5-4.5")
        span(class="text-[15px] font-bold text-gray-900") FallAI

div(class="mx-2 mb-4 rounded-lg border border-indigo-100 bg-indigo-50/70 p-3")
    p(class="text-[13px] font-semibold text-indigo-700") RF-Dual 운영 콘솔
    p(class="mt-1 text-xs leading-5 text-indigo-600") 업로드·웹캠 로그, 낙상 판단 기준, 파이프라인 설명을 한 화면에서 확인합니다.

nav(class="flex flex-1 flex-col overflow-y-auto")
    ul(role="list", class="flex flex-1 flex-col gap-y-4 mx-2")
        li
            div(class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 px-2") Main
            ul(role="list", class="mt-1 space-y-0.5")
                li
                    a(routerLink="/", [class]="activeClass('/')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M3 16.5V6.75A2.25 2.25 0 0 1 5.25 4.5h13.5A2.25 2.25 0 0 1 21 6.75v9.75A2.25 2.25 0 0 1 18.75 18.75H5.25A2.25 2.25 0 0 1 3 16.5Zm5.25-6.75 2.25 2.25 5.25-5.25")
                        span(class="truncate") 영상 분석 메인
                li
                    a(routerLink="/pipeline", [class]="activeClass('/pipeline')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5")
                        span(class="truncate") AI 파이프라인
                li
                    a(routerLink="/models", [class]="activeClass('/models')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 6.75A2.25 2.25 0 0 1 6 4.5h12a2.25 2.25 0 0 1 2.25 2.25v10.5A2.25 2.25 0 0 1 18 19.5H6a2.25 2.25 0 0 1-2.25-2.25V6.75Zm4.5 2.25h7.5m-7.5 3h7.5m-7.5 3h4.5")
                        span(class="truncate") 모델 관리

        li(*ngIf="isAdmin()")
            div(class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 px-2") Admin
            ul(role="list", class="mt-1 space-y-0.5")
                li
                    a(routerLink="/admin/analysis", [class]="activeClass('/admin/analysis')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M10.5 6h9m-9 6h9m-9 6h9M4.5 6h.008v.008H4.5V6Zm0 6h.008v.008H4.5V12Zm0 6h.008v.008H4.5V18Z")
                        span(class="truncate") 관리자 분석 설정
                li
                    a(routerLink="/admin/llm", [class]="activeClass('/admin/llm')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5.16 14.34M9.75 3.104c.251.023.501.05.75.082m-.75-.082a24.301 24.301 0 0 0-4.5 0m4.5 0v.75m.75-.668a24.301 24.301 0 0 1 4.5 0m0 0v.75m0-.75c.251.023.501.05.75.082m-5.25 0h4.5m-7.5 7.5h9m-9 0 3.75 6.495a2.25 2.25 0 0 0 3.897 0l3.75-6.495")
                        span(class="truncate") LLM 판독 설정

        li
            div(class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 px-2") Help
            ul(role="list", class="mt-1 space-y-0.5")
                li
                    a(routerLink="/manual", [class]="activeClass('/manual')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25")
                        span(class="truncate") 사용 설명서
                li
                    a(routerLink="/presentation", [class]="activeClass('/presentation')")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 3.75h16.5M3.75 8.25h16.5m-16.5 4.5h7.5m-7.5 4.5h7.5")
                        span(class="truncate") 포트폴리오/PDF
