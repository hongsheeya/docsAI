                    class="rounded-xl border border-zinc-200 bg-zinc-950 px-3 py-8 text-center text-xs text-zinc-300")
                    div(class="text-[13px] font-semibold") 스켈레톤 전용 보기
                    div(class="mt-1 text-[11px] text-zinc-500") 원본 기준 영상은 원본 모드에서만 표시됩니다.
                div(class="mt-2 text-xs text-zinc-500") {{ referencePopupData.clip_info?.message || '' }}

//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//- 119 응급 팝업
//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
div(*ngIf="emergencyPopupOpen && alertWorkflow?.emergency",
    class="fixed inset-0 z-[60] flex items-center justify-center",
    style="background:rgba(0,0,0,0.7)",
    (click)="closeEmergencyPopup()")
    div(class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden",
        (click)="$event.stopPropagation()")
        div(class="bg-rose-600 p-4 text-white text-center")
            div(class="text-3xl mb-1") 🚨
            div(class="text-lg font-bold") 응급 상황
        div(class="p-4 space-y-3")
            div(class="text-[13px] text-zinc-700") {{ alertWorkflow.emergency.popup_message }}
            div(*ngIf="alertWorkflow.emergency.call_script",
                class="bg-rose-50 border border-rose-200 rounded-xl p-3 text-xs text-rose-800 whitespace-pre-line") {{ alertWorkflow.emergency.call_script }}
            div(class="flex gap-2 mt-2")
                a(href="tel:119",
                    class="flex-1 py-3 bg-rose-600 text-white rounded-xl text-center text-[13px] font-bold hover:bg-rose-700") 📞 119 전화
                button((click)="closeEmergencyPopup()",
                    class="flex-1 py-3 border border-zinc-300 rounded-xl text-[13px] text-zinc-600 hover:bg-zinc-50") 닫기
