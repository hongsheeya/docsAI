//- ── 숨겨진 파일 입력 ──
input(type="file", accept="video/*,.zip,.tar,.tar.gz,.tgz", multiple="",
    #fileInput="",
    (change)="onFileSelected($event)",
    style="display:none")

//- ── 네비게이션 헤더 ──
nav(class="shrink-0 bg-white border-b border-zinc-200 z-30")
    div(class="max-w-[1800px] mx-auto px-4 sm:px-6 h-[52px] flex items-center justify-between")
        div(class="flex items-center gap-3")
            span(class="inline-flex size-8 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 via-blue-600 to-cyan-500 p-1 shadow-sm")
                img(src="/assets/brand/fallai-mark.svg", alt="FallAI", class="size-6")
            div
                span(class="text-lg font-semibold text-zinc-950") FallAI
                span(class="ml-2 text-xs text-zinc-400") RF-Dual · XG-Posture
        div(class="flex items-center gap-2")
            a(routerLink="/",
                class="inline-flex items-center rounded-xl border border-sky-200 bg-sky-50 px-3 py-1.5 text-[13px] font-semibold text-sky-700") 메인
            a(routerLink="/pipeline",
                class="inline-flex items-center rounded-xl border border-zinc-300 bg-white px-3 py-1.5 text-[13px] font-medium text-zinc-700 hover:bg-zinc-50") 파이프라인
            a(routerLink="/manual",
                class="inline-flex items-center rounded-xl border border-zinc-300 bg-white px-3 py-1.5 text-[13px] font-medium text-zinc-700 hover:bg-zinc-50") 설명서
            a(*ngIf="service.auth?.check?.role('admin') === true",
                routerLink="/admin/analysis",
                class="inline-flex items-center rounded-xl border border-zinc-300 bg-white px-3 py-1.5 text-[13px] font-medium text-zinc-700 hover:bg-zinc-50") 관리자
            div(class="inline-flex items-center rounded-xl border border-zinc-300 bg-zinc-50 p-0.5")
                button(type="button",
                    (click)="setPrivacyViewMode('skeleton')",
                    class="px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-colors",
                    [ngClass]="isSkeletonPrivacyMode() ? 'bg-zinc-900 text-white shadow-sm' : 'text-zinc-500 hover:text-zinc-800'") 스켈레톤
                button(type="button",
                    (click)="setPrivacyViewMode('raw')",
                    class="px-2.5 py-1 rounded-lg text-[11px] font-semibold transition-colors",
                    [ngClass]="canShowRawVideo() ? 'bg-zinc-900 text-white shadow-sm' : 'text-zinc-500 hover:text-zinc-800'") 원본
            button(*ngIf="inputMode === 'upload'",
                (click)="switchInputMode('webcam')",
                class="text-xs px-3 py-1 rounded-lg border border-zinc-200 hover:bg-zinc-50 text-zinc-600") 실시간 모드
            button(*ngIf="inputMode === 'webcam'",
                (click)="switchInputMode('upload')",
                class="text-xs px-3 py-1 rounded-lg border border-zinc-200 hover:bg-zinc-50 text-zinc-600") 업로드 모드
            button(type="button",
                (click)="switchInputMode('upload'); setUploadWorkflowMode('train')",
                class="text-xs px-3 py-1 rounded-lg border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold") 학습 모드

//- ── 히어로 섹션 (업로드 모드만) ──
section(*ngIf="inputMode !== 'webcam'",
    class="bg-gradient-to-b from-zinc-50 to-white py-8")
    div(class="max-w-[1800px] mx-auto px-4 sm:px-6")
        h1(class="text-lg font-semibold text-zinc-950 mb-1") AI 낙상 감지 분석 / 학습
        p(class="text-[13px] text-zinc-500 mb-4") 분석용 단일 영상과 학습용 대량 영상/압축 파일을 같은 화면에서 처리합니다
        div(class="grid md:grid-cols-3 gap-4")
            div(class="bg-white rounded-xl border border-zinc-200 p-4")
                div(class="text-xs text-zinc-400 mb-1") 지원 포맷
                div(class="text-[13px] text-zinc-700") MP4, MOV, AVI, MKV, WebM, ZIP/TAR
            div(class="bg-white rounded-xl border border-zinc-200 p-4")
                div(class="text-xs text-zinc-400 mb-1") 운영 모델
                div(class="flex items-center gap-2")
                    div(class="text-[13px] text-zinc-700") {{ currentEngineLabel() }}
                    span(class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-medium",
                        [ngClass]="{'bg-emerald-100 text-emerald-700': currentModelStatusLabel() === 'ready', 'bg-amber-100 text-amber-700': currentModelStatusLabel() === 'fallback', 'bg-rose-100 text-rose-700': currentModelStatusLabel() === 'missing'}") {{ currentModelStatusText() }}
                div(*ngIf="currentModelWeightsPath()",
                    class="mt-1 break-all text-[10px] text-zinc-400") {{ currentModelWeightsPath() }}
            div(class="bg-white rounded-xl border border-zinc-200 p-4")
                div(class="text-xs text-zinc-400 mb-1") 학습 데이터
                div(class="text-[13px] text-zinc-700") {{ prototypeInfo?.dataset_summary?.fall_sample_count || 0 }}건
        div(class="mt-4 rounded-2xl border border-indigo-100 bg-indigo-50 px-4 py-3", *ngIf="prototypeInfo?.chunk_policy?.upload")
            p(class="text-[13px] font-semibold text-indigo-900") 업로드 분할 정책
            p(class="mt-1 text-xs text-indigo-700") {{ prototypeInfo?.chunk_policy?.upload?.headline }}

//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//- 메인 분석 영역
//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//- ── 웹캠 모드 ──
section(*ngIf="inputMode === 'webcam'",
    class="flex-1 min-h-0 flex flex-col overflow-hidden bg-zinc-900")
    div(class="flex-1 min-h-0 overflow-hidden grid grid-cols-[1fr_380px] grid-rows-[1fr] gap-0")
        //- 좌측: 비디오 영역
        div(class="relative flex flex-col min-h-0 bg-black")
            div(class="flex-1 min-h-0 relative")
                video(#webcamVideo="",
                    autoplay="", playsinline="", muted="",
                    class="w-full h-full object-contain transition-opacity duration-200",
                    style="z-index:0",
                    [attr.aria-hidden]="isSkeletonPrivacyMode() ? 'true' : null",
                    [style.opacity]="isSkeletonPrivacyMode() ? 0 : 1",
                    [style.visibility]="isSkeletonPrivacyMode() ? 'hidden' : 'visible'")
                div(*ngIf="isSkeletonPrivacyMode()",
                    class="absolute inset-0 bg-black pointer-events-none",
                    style="z-index:1")
                canvas(#mpPoseCanvas="",
                    data-mp-pose-canvas="",
                    class="absolute inset-0 w-full h-full pointer-events-none",
                    style="z-index:2")
                canvas(#realtimeBboxCanvas="",
                    class="absolute inset-0 w-full h-full pointer-events-none",
                    style="z-index:3")
                div(*ngIf="isSkeletonPrivacyMode()",
                    class="absolute bottom-3 left-3 z-10 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-[10px] font-semibold text-zinc-200 backdrop-blur")
                    span {{ privacyViewLabel() }}
                //- 실시간 오버레이 패널
                div(*ngIf="realtimeActive || analysisResult",
                    class="absolute top-3 left-3 z-10",
                    style="min-width:260px; max-width:380px")
                    div(class="rounded-2xl backdrop-blur-md p-3",
                        [ngClass]="{'bg-black/70': realtimeOverlayLevel !== 'high', 'bg-rose-900/80': realtimeOverlayLevel === 'high', 'ring-2 ring-rose-400': realtimeOverlayFlash}")
                        //- 점수 바
                        div(class="flex items-center gap-3 mb-2")
                            div(class="text-2xl font-bold",
                                [class.text-emerald-400]="realtimeOverlayLevel === 'low'",
                                [class.text-amber-400]="realtimeOverlayLevel === 'medium'",
                                [class.text-rose-400]="realtimeOverlayLevel === 'high'") {{ realtimeOverlayScore }}%
                            div(class="flex-1")
                                div(class="text-xs text-zinc-300") {{ realtimeOverlayLabel }}
                                div(class="mt-1 h-1 rounded-full overflow-hidden",
                                    style="background:rgba(255,255,255,0.2)")
                                    div(class="h-full rounded-full transition-all duration-500",
                                        [class.bg-emerald-400]="realtimeOverlayLevel === 'low'",
                                        [class.bg-amber-400]="realtimeOverlayLevel === 'medium'",
                                        [class.bg-rose-400]="realtimeOverlayLevel === 'high'",
                                        [style.width.%]="realtimeOverlayScore")
                        //- 자세 라벨
                        div(*ngIf="hasPostureData()",
                            class="text-xs text-zinc-300 mb-1") {{ postureDisplayCaption() }}: {{ postureLabel() }}
                        //- 6-class 확률 분포 바
                        div(*ngIf="hasPostureData()",
                            class="space-y-1 mb-2")
                            div(*ngFor="let item of postureItems()",
                                class="flex items-center gap-1 text-[10px] rounded px-1",
                                [ngStyle]="{'background': item.active ? 'rgba(255,255,255,0.1)' : 'transparent'}")
                                span(class="w-3") {{ item.icon }}
                                span(class="w-8 text-zinc-400",
                                    [class.text-zinc-200]="item.active") {{ item.label }}
                                div(class="flex-1 h-1 rounded-full overflow-hidden",
                                    style="background:rgba(255,255,255,0.1)")
                                    div(class="h-full rounded-full bg-sky-400 transition-all",
                                        [style.width.%]="item.percent")
                                span(class="w-8 text-right text-zinc-400") {{ item.percent }}%
                        //- 표정 분석 결과
                        div(*ngIf="hasFacialStateAux()",
                            class="mt-2 mb-2 rounded-lg border border-white/10 bg-white/5 px-2 py-2")
                            div(class="flex items-center justify-between gap-2 mb-1")
                                span(class="text-[10px] font-semibold text-zinc-200") 표정: {{ facialStateLabel() }}
                                span(class="text-[10px] text-zinc-400") {{ facialStatePercent() }}%
                            div(class="space-y-1")
                                div(*ngFor="let item of facialStateItems()",
                                    class="flex items-center gap-1 text-[10px]")
                                    span(class="w-10 text-zinc-400") {{ item.label }}
                                    div(class="flex-1 h-1 rounded-full overflow-hidden",
                                        style="background:rgba(255,255,255,0.1)")
                                        div(class="h-full rounded-full transition-all",
                                            [style.width.%]="item.percent",
                                            [style.background]="item.color")
                                    span(class="w-7 text-right text-zinc-400") {{ item.percent }}%
                            div(*ngIf="facialEvidenceLines().length > 0",
                                class="mt-1 space-y-0.5")
                                div(*ngFor="let line of facialEvidenceLines() | slice:0:2",
                                    class="text-[9px] leading-tight text-zinc-400") {{ line }}
                        //- FN-0006: 자세 전환 표시
                        div(*ngIf="postureTransitionText",
                            class="flex items-center gap-1 text-[10px] text-amber-400 mb-1")
                            span ↔
                            span {{ postureTransitionText }}
                        //- FN-0006: 빈번한 자세 변화 경고
                        div(*ngIf="isPostureFrequentChange()",
                            class="text-[10px] text-amber-400 mb-1")
                            span ⚡ 빈번한 자세 변화 감지
                        //- FN-0006: 최근 자세 분포 (mini summary)
                        div(*ngIf="postureTimeline.length >= 3",
                            class="flex items-center gap-1 flex-wrap mb-1")
                            span(*ngFor="let ps of recentPostureSummary()",
                                class="text-[10px] px-1 rounded",
                                [ngClass]="{'bg-white/10 text-zinc-200': ps.posture === currentPosture, 'text-zinc-500': ps.posture !== currentPosture}") {{ ps.label }} {{ ps.pct }}%
                        //- 판단 근거
                        div(*ngIf="realtimeOverlayBasis",
                            class="text-[10px] text-zinc-400 leading-tight") {{ realtimeOverlayBasis }}

            //- 컨트롤 바 (하단)
            div(class="shrink-0 bg-zinc-800 border-t border-zinc-700 p-3")
                div(class="flex items-center gap-3 flex-wrap")
                    //- 시작/중지
                    button(*ngIf="!realtimeActive",
                        (click)="startRealtimeAnalysis()",
                        [disabled]="!webcamReady",
                        class="px-4 py-2 rounded-lg bg-emerald-600 text-white text-[13px] font-medium hover:bg-emerald-700 disabled:opacity-50") ▶ 분석 시작
                    button(*ngIf="realtimeActive",
                        (click)="stopRealtimeAnalysis()",
                        class="px-4 py-2 rounded-lg bg-rose-600 text-white text-[13px] font-medium hover:bg-rose-700") ■ 중지
                    //- MediaPipe 상태
                    span(class="text-[10px] text-zinc-400")
                        span(*ngIf="mpInitializing") 포즈 모델 로딩...
                        span(*ngIf="mpReady && mpRunning") 🦴 {{ mpFps }}fps
                        span(*ngIf="!mpReady && !mpInitializing") 포즈 대기
                    //- 성능 모니터
                    span(*ngIf="realtimeActive",
                        class="text-[10px] text-zinc-500") RTT {{ realtimePerfStats.avgRtt | number:'1.0-0' }}ms · 서버 {{ realtimePerfStats.avgServer | number:'1.0-0' }}ms
                    span(*ngIf="realtimeActive && realtimePerfStats.warmupMs",
                        class="text-[10px] text-zinc-500") 예열 {{ realtimePerfStats.warmupMs | number:'1.0-0' }}ms
                    //- 청크 정책 + 큐 상태
                    span(*ngIf="realtimeActive",
                        class="text-[10px] px-1.5 py-0.5 rounded bg-sky-800 text-sky-200") {{ prototypeInfo?.chunk_policy?.realtime?.version === 'dense-bootstrap-v2' ? '4초 · 3fps · 무삭제 큐' : '4초 레거시' }}
                    span(*ngIf="realtimeActive && dispatchQueueSize > 0",
                        class="text-[10px] text-amber-400") 큐 {{ dispatchQueueSize }}
                    span(*ngIf="realtimeActive && realtimePerfStats.retrying > 0",
                        class="text-[10px] text-amber-300") 재시도 {{ realtimePerfStats.retrying }}
                    //- 모델 선택
                    select([(ngModel)]="selectedModelType",
                        disabled="",
                        class="text-[10px] bg-zinc-700 text-zinc-300 rounded px-2 py-1 border-none opacity-80")
                        option(value="rf-dual") RF-Dual

        //- 우측: 로그 사이드 패널
        div(class="flex flex-col min-h-0 overflow-hidden bg-zinc-800 border-l border-zinc-700")
            div(class="shrink-0 px-3 py-2 border-b border-zinc-700 flex items-center justify-between")
                span(class="text-xs font-medium text-zinc-300") 분석 로그
                div(class="flex items-center gap-2")
                    span(class="text-[10px] text-zinc-500") {{ realtimeLogEntries.length }}건
                    button(*ngIf="realtimeLogEntries.length > 0",
                        (click)="clearAllLogs()",
                        class="text-zinc-500 hover:text-rose-400 text-[10px]",
                        title="전체 삭제") 🗑
            //- 로그 목록 (스크롤 영역)
            div(#logScrollContainer="",
                class="flex-1 min-h-0 overflow-y-auto",
                style="overscroll-behavior: contain")
                //- 빈 안내
                div(*ngIf="realtimeLogEntries.length === 0",
                    class="flex flex-col items-center justify-center h-full text-zinc-500 text-xs p-4")
                    div(class="text-3xl mb-2") 📋
                    div 실시간 분석을 시작하면 로그가 표시됩니다
                //- 로그 항목
                div(*ngFor="let entry of realtimeLogEntries",
                    (click)="openLogDetail(entry)",
                    class="px-3 py-2 border-b cursor-pointer transition-colors",
                    style="border-color:rgba(63,63,70,0.5)",
                    [ngClass]="{'hover:bg-zinc-700': true}")
                    div(class="flex items-center gap-2")
                        div(class="w-2 h-2 rounded-full shrink-0",
                            [ngClass]="logRiskDotClass(entry.level)")
                        div(class="flex-1 min-w-0")
                            div(class="flex items-center gap-1")
                                span(class="text-[10px] font-medium",
                                    [ngClass]="logRiskClass(entry.level)") {{ entry.label }}
                                //- bootstrap phase badge
                                span(*ngIf="entry.chunkWindow?.phase === 'bootstrap'",
                                    class="text-[9px] px-1 py-0.5 rounded bg-zinc-700 text-zinc-400 shrink-0") 초기 분석
                                //- FN-0006: Show posture label prominently for dual modes
                                span(*ngIf="entry.postureLabel && entry.runtimeKey === 'rf-dual' && entry.chunkWindow?.phase !== 'bootstrap'",
                                    class="text-[10px] text-sky-400") {{ entry.postureLabel }}
                                span(class="text-[10px] text-zinc-500") {{ (entry.score * 100) | number:'1.0-0' }}%
                                span(*ngIf="entry.feedbackDone",
                                    class="text-[10px] text-emerald-500") ✓
                            div(class="text-[10px] text-zinc-500 truncate") {{ entry.chunkLabel || entry.timestamp }} · {{ entry.elapsed | number:'1.1-1' }}초
                            div(*ngIf="entry.oneLine",
                                class="text-[10px] text-zinc-300 truncate") {{ entry.oneLine }}
                            div(*ngIf="entry.basis",
                                class="text-[10px] text-zinc-500 truncate") {{ entry.basis }}
                        button((click)="deleteLogEntry(entry, $event)",
                            class="shrink-0 text-zinc-600 hover:text-rose-400 text-[10px]") ✕

//- ── 업로드 모드 ──
section(*ngIf="inputMode === 'upload'",
    class="py-6")
    div(class="max-w-[1800px] mx-auto px-4 sm:px-6")
        div(class="grid md:grid-cols-2 gap-6")
            //- 비디오 프리뷰 / 드래그앤드롭
            div(class="relative")
                div(*ngIf="!selectedVideoUrl",
                    (drop)="onDrop($event)",
                    (dragover)="onDragOver($event)",
                    (dragleave)="onDragLeave($event)",
                    (click)="fileInput.click()",
                    class="border-2 border-dashed rounded-2xl p-12 text-center cursor-pointer transition-colors",
                    [class.border-blue-400]="dragover",
                    [class.border-zinc-300]="!dragover",
                    [class.bg-blue-50]="dragover")
                    div(class="text-4xl mb-3") 🎬
                    div(class="text-[13px] text-zinc-600") 영상/압축 파일을 드래그하거나 클릭하여 선택
                    div(class="text-xs text-zinc-400 mt-1") 여러 영상 또는 ZIP/TAR 일괄 등록 지원
                div(*ngIf="selectedVideoUrl",
                    class="relative rounded-2xl overflow-hidden bg-black")
                    video(#uploadPreviewVideo="",
                        [src]="selectedVideoUrl",
                        [attr.controls]="canShowRawVideo() ? '' : null",
                        (timeupdate)="onUploadVideoTimeUpdate()",
                        class="w-full max-h-[500px] object-contain transition-opacity duration-200",
                        style="z-index:0",
                        [attr.aria-hidden]="isSkeletonPrivacyMode() ? 'true' : null",
                        [style.pointer-events]="isSkeletonPrivacyMode() ? 'none' : 'auto'",
                        [style.opacity]="isSkeletonPrivacyMode() ? 0 : 1",
                        [style.visibility]="isSkeletonPrivacyMode() ? 'hidden' : 'visible'")
                    div(*ngIf="isSkeletonPrivacyMode()",
                        class="absolute inset-0 bg-black pointer-events-none",
                        style="z-index:1")
                    canvas(#uploadBboxCanvas="",
                        class="absolute inset-0 w-full h-full pointer-events-none",
                        style="z-index:2")
                    canvas(#detCanvas="",
                        class="absolute inset-0 w-full h-full pointer-events-none",
                        style="z-index:3")
                    div(*ngIf="isSkeletonPrivacyMode()",
                        class="absolute bottom-2 left-2 z-10 rounded-full border border-white/10 bg-black/60 px-3 py-1 text-[10px] font-semibold text-zinc-200 backdrop-blur") {{ privacyViewLabel() }}
                    button((click)="clearSelectedFile()",
                        class="absolute top-2 right-2 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm",
                        style="background:rgba(0,0,0,0.5)") ✕
                div(*ngIf="selectedUploadCount() > 0",
                    class="mt-3 rounded-xl border border-sky-100 bg-sky-50 px-4 py-3")
                    div(class="text-[12px] font-semibold text-sky-900") {{ selectedUploadSummary() }}
                    div(class="mt-1 text-[11px] text-sky-700") {{ selectedUploadTrainingHint() }}
            //- 업로드 컨트롤
            div(class="space-y-4")
                div(class="bg-white rounded-xl border border-zinc-200 p-2")
                    div(class="grid grid-cols-2 gap-2")
                        button(type="button",
                            (click)="setUploadWorkflowMode('analyze')",
                            class="rounded-lg px-3 py-2 text-[12px] font-semibold transition-colors",
                            [ngClass]="uploadWorkflowMode === 'analyze' ? 'bg-blue-600 text-white shadow-sm' : 'bg-zinc-50 text-zinc-600 hover:bg-zinc-100'") 분석 모드
                        button(type="button",
                            (click)="setUploadWorkflowMode('train')",
                            class="rounded-lg px-3 py-2 text-[12px] font-semibold transition-colors",
                            [ngClass]="uploadWorkflowMode === 'train' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-zinc-50 text-zinc-600 hover:bg-zinc-100'") 학습 모드
                div(class="bg-white rounded-xl border border-zinc-200 p-4 space-y-3")
                    div(class="text-[13px] font-medium text-zinc-700") 분석 설정
                    div(class="flex items-center gap-2")
                        label(class="text-xs text-zinc-500 w-16") 모델
                        select([(ngModel)]="selectedModelType",
                            disabled="",
                            class="flex-1 text-[13px] border border-zinc-200 rounded-lg px-3 py-2 bg-zinc-50 text-zinc-600")
                            option(value="rf-dual") RF-Dual (Fall+Posture)
                    div(class="text-[10px] text-zinc-400") 예상 소요: {{ modelSpeedHint() }}
                    div(class="rounded-xl border border-indigo-100 bg-indigo-50 px-3 py-2", *ngIf="prototypeInfo?.chunk_policy?.upload")
                        p(class="text-[11px] font-semibold text-indigo-900") 분할 로그 정책
                        p(class="mt-1 text-[10px] text-indigo-700") {{ prototypeInfo?.chunk_policy?.upload?.headline }}
                button(*ngIf="uploadWorkflowMode === 'analyze'",
                    (click)="analyze()",
                    [disabled]="!selectedFile || analyzing",
                    class="w-full py-3 rounded-xl text-white font-medium text-[13px] transition-colors",
                    [class.bg-blue-600]="!analyzing",
                    [class.hover:bg-blue-700]="!analyzing",
                    [class.bg-zinc-400]="analyzing",
                    [class.cursor-not-allowed]="analyzing")
                    span(*ngIf="!analyzing") 🔍 분석 시작
                    span(*ngIf="analyzing") ⏳ 분석 중...
                div(*ngIf="uploadWorkflowMode === 'train'",
                    class="bg-white rounded-xl border border-emerald-100 p-4 space-y-3")
                    div(class="flex items-center justify-between gap-2")
                        div
                            div(class="text-[13px] font-semibold text-zinc-800") 추가 학습 데이터 등록
                            div(class="mt-0.5 text-[10px] text-zinc-500") 선택한 영상/압축 파일 전체를 intake 라벨 폴더에 저장합니다.
                        span(class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-semibold text-emerald-700") training
                    div(class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-3")
                        div(class="flex items-center justify-between gap-2")
                            div
                                div(class="text-[12px] font-semibold text-emerald-900") 82번 표정 모델 연속 학습
                                div(class="mt-1 text-[10px] text-emerald-700") {{ continuousTrainingStageText() }}
                            button(type="button",
                                (click)="loadContinuousTrainingStatus()",
                                class="rounded-lg border border-emerald-200 bg-white px-2 py-1 text-[10px] font-semibold text-emerald-700 hover:bg-emerald-50") 새로고침
                        div(class="mt-2 grid grid-cols-1 gap-2 text-[10px] text-emerald-800 sm:grid-cols-2")
                            div(class="rounded-lg border border-emerald-100 bg-white px-2 py-1.5")
                                div(class="text-emerald-500") 성능
                                div(class="mt-0.5 font-semibold") {{ continuousTrainingMetricText() }}
                            div(class="rounded-lg border border-emerald-100 bg-white px-2 py-1.5")
                                div(class="text-emerald-500") 최근 갱신
                                div(class="mt-0.5 font-semibold") {{ continuousTrainingUpdatedText() }}
                        div(*ngIf="continuousTrainingStatus?.latest_log",
                            class="mt-2 truncate text-[10px] text-emerald-700") {{ continuousTrainingStatus.latest_log }}
                    div(class="grid grid-cols-1 sm:grid-cols-2 gap-2")
                        label(class="space-y-1")
                            span(class="text-[10px] font-semibold text-zinc-500") 낙상 라벨
                            select([(ngModel)]="trainingUploadLabel",
                                class="w-full text-[12px] border border-zinc-200 rounded-lg px-3 py-2 bg-white")
                                option(value="N") 비낙상 N
                                option(value="Y") 낙상 Y
                        label(class="space-y-1")
                            span(class="text-[10px] font-semibold text-zinc-500") 행동 라벨
                            select([(ngModel)]="trainingUploadPostureClass",
                                class="w-full text-[12px] border border-zinc-200 rounded-lg px-3 py-2 bg-white")
                                option(value="") 선택 안 함
                                option(*ngFor="let item of postureClasses", [value]="item.code") {{ item.label }} ({{ item.code }})
                    textarea([(ngModel)]="trainingUploadNote",
                        rows="2",
                        placeholder="가림, 수직 가림, 오분류 상황 등 메모",
                        class="w-full text-[12px] border border-zinc-200 rounded-lg px-3 py-2 resize-none")
                    div(class="grid grid-cols-1 sm:grid-cols-2 gap-2")
                        button((click)="registerSelectedFileForTraining()",
                            [disabled]="selectedUploadCount() === 0 || trainingUploading || trainingJobStarting",
                            class="w-full py-2.5 rounded-xl text-[12px] font-semibold transition-colors",
                            [class.bg-emerald-600]="!trainingUploading",
                            [class.text-white]="!trainingUploading",
                            [class.hover:bg-emerald-700]="!trainingUploading",
                            [class.bg-zinc-200]="trainingUploading",
                            [class.text-zinc-500]="trainingUploading")
                            span(*ngIf="!trainingUploading") 데이터 등록만
                            span(*ngIf="trainingUploading") 등록 중... {{ trainingUploadDone }}/{{ trainingUploadTotal }}
                        button((click)="registerAndStartBackgroundTraining()",
                            [disabled]="selectedUploadCount() === 0 || trainingUploading || trainingJobStarting",
                            class="w-full py-2.5 rounded-xl text-[12px] font-semibold transition-colors",
                            [class.bg-zinc-900]="!trainingJobStarting",
                            [class.text-white]="!trainingJobStarting",
                            [class.hover:bg-black]="!trainingJobStarting",
                            [class.bg-zinc-200]="trainingJobStarting",
                            [class.text-zinc-500]="trainingJobStarting")
                            span(*ngIf="!trainingJobStarting") 등록 후 백그라운드 학습
                            span(*ngIf="trainingJobStarting") 학습 job 시작 중...
                    button((click)="startBackgroundTraining()",
                        [disabled]="trainingJobStarting",
                        class="w-full py-2 rounded-xl border border-emerald-200 bg-emerald-50 text-[12px] font-semibold text-emerald-700 hover:bg-emerald-100 disabled:opacity-50") 이미 등록된 데이터로 학습 시작
                    div(*ngIf="trainingUploadMessage",
                        class="rounded-lg px-3 py-2 text-[12px]",
                        [class.bg-emerald-50]="trainingUploadMessageType === 'success'",
                        [class.text-emerald-700]="trainingUploadMessageType === 'success'",
                        [class.bg-rose-50]="trainingUploadMessageType === 'error'",
                        [class.text-rose-700]="trainingUploadMessageType === 'error'") {{ trainingUploadMessage }}
                    div(*ngIf="trainingJob",
                        class="rounded-xl border border-zinc-200 bg-zinc-50 p-3 space-y-2")
                        div(class="flex items-center justify-between gap-2")
                            div(class="text-[12px] font-semibold text-zinc-800") 학습 현황
                            span(class="rounded-full px-2 py-1 text-[10px] font-semibold",
                                [ngClass]="{'bg-emerald-100 text-emerald-700': trainingJob.status === 'completed_pending_apply' || trainingJob.status === 'applied', 'bg-blue-100 text-blue-700': trainingJob.status === 'running' || trainingJob.status === 'queued', 'bg-rose-100 text-rose-700': trainingJob.status === 'failed'}") {{ trainingJobStatusText() }}
                        div(class="h-2 rounded-full bg-zinc-200 overflow-hidden")
                            div(class="h-full rounded-full bg-emerald-500 transition-all",
                                [style.width.%]="trainingJobProgressPercent()")
                        div(class="grid grid-cols-3 gap-2 text-[11px] text-zinc-600")
                            div
                                div(class="text-zinc-400") 진행
                                div(class="font-semibold text-zinc-800") {{ trainingJobProgressPercent() }}%
                            div
                                div(class="text-zinc-400") 처리
                                div(class="font-semibold text-zinc-800") {{ trainingJob.processed || 0 }} / {{ trainingJob.total || 0 }}
                            div
                                div(class="text-zinc-400") ETA
                                div(class="font-semibold text-zinc-800") {{ trainingJobEtaText() }}
                        div(class="text-[11px] text-zinc-500") {{ trainingJob.message || trainingJob.stage }}
                        div(*ngIf="trainingJob.result",
                            class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]")
                            div(class="rounded-lg bg-white border border-zinc-200 px-3 py-2")
                                div(class="text-zinc-400") RF 학습 샘플
                                div(class="font-semibold text-zinc-900") {{ trainingJob.result?.rf_pipeline_training?.training_samples || '-' }}
                            div(class="rounded-lg bg-white border border-zinc-200 px-3 py-2")
                                div(class="text-zinc-400") 자세 F1
                                div(class="font-semibold text-zinc-900") {{ trainingJob.result?.xg_posture_training?.cv?.f1_macro || '-' }}
                        button(*ngIf="trainingJobCanApply()",
                            (click)="applyTrainingJob()",
                            [disabled]="trainingJobApplying",
                            class="w-full rounded-xl bg-blue-600 px-3 py-2 text-[12px] font-semibold text-white hover:bg-blue-700 disabled:opacity-50")
                            span(*ngIf="!trainingJobApplying") 학습 결과 적용
                            span(*ngIf="trainingJobApplying") 적용 중...
                //- 에러 메시지
                div(*ngIf="errorMessage",
                    class="bg-rose-50 border border-rose-200 rounded-xl p-3 text-[13px] text-rose-700") {{ errorMessage }}

//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//- 분석 결과 (업로드 모드 전용)
//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

div(*ngIf="analysisResult && inputMode !== 'webcam'",
    class="max-w-[1800px] mx-auto px-4 sm:px-6 pb-12")
    //- ── 결과 요약 ──
    div(class="mb-6")
        div(class="rounded-2xl border p-6",
            [ngClass]="riskBgClass(analysisResult.risk_level)")
            div(class="grid md:grid-cols-4 gap-6")
                //- 위험 점수
                div
                    div(class="text-xs text-zinc-500 mb-1") 위험 점수
                    div(class="text-3xl font-bold",
                        [ngClass]="riskClass(analysisResult.risk_level)") {{ riskScorePercent() }}%
                    div(class="mt-1")
                        span(class="text-xs px-2 py-0.5 rounded-full",
                            [ngClass]="riskBadgeClass(analysisResult.risk_level)") {{ analysisResult.risk_label }}
                    div(class="text-xs text-zinc-500 mt-2") {{ analysisResult.summary }}
                //- 행동 분류
                div
                    div(class="text-xs text-zinc-500 mb-1") 행동 분류
                    div(class="text-[15px] font-semibold text-zinc-900") {{ analysisResult.behavior_label }}
                    div(*ngIf="isDualModeResult() && hasPostureData()")
                        div(class="mt-1 text-xs text-zinc-500") {{ postureDisplayCaption() }}: {{ postureLabel() }}
                        div(*ngIf="postureDisplayHint()",
                            class="mt-1 text-[11px] text-zinc-400") {{ postureDisplayHint() }}
                        div(class="flex items-center gap-2 mt-1")
                            span(class="text-[10px] px-2 py-0.5 rounded-full border",
                                [ngClass]="decisionStateMeta().badgeCls") {{ decisionStateMeta().icon }} {{ decisionStateMeta().label }}
                //- 표정 분석
                div
                    div(class="text-xs text-zinc-500 mb-1") 표정 분석
                    div(class="text-[15px] font-semibold text-zinc-900") {{ facialStateLabel() }}
                    div(*ngIf="hasFacialStateAux()",
                        class="mt-1 text-xs text-zinc-500") {{ facialStateAuxText() }}
                    div(*ngIf="hasFacialStateAux()",
                        class="mt-2 h-1.5 rounded-full bg-zinc-100 overflow-hidden")
                        div(class="h-full rounded-full bg-cyan-500",
                            [style.width.%]="facialStatePercent()")
                //- 엔진 / 타이밍
                div
                    div(class="text-xs text-zinc-500 mb-1") 분석 엔진
                    div(class="text-[13px] text-zinc-700") {{ currentEngineLabel() }}
                    div(*ngIf="analysisResult.server_timing",
                        class="text-xs text-zinc-400 mt-1") 서버 처리: {{ analysisResult.server_timing.total_server_sec | number:'1.2-2' }}초

            div(*ngIf="llmInterpretationText() || llmInterpretationStatus()",
                class="mt-4 rounded-xl border border-sky-100 bg-sky-50/70 p-4")
                div(class="flex items-center justify-between gap-3")
                    div(class="text-[13px] font-semibold text-sky-950") LLM 판단 근거
                    div(class="text-[11px] text-sky-700") {{ llmInterpretationStatus() }}
                div(*ngIf="llmInterpretationText()",
                    class="mt-2 text-[13px] leading-6 text-sky-950 whitespace-pre-line") {{ llmInterpretationText() }}
            div(*ngIf="analysisResult.runtime_warning",
                class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4")
                div(class="text-[13px] font-semibold text-amber-900") {{ analysisResult.runtime_warning.title || '분석 주의' }}
                div(class="mt-1 text-[12px] leading-5 text-amber-800") {{ analysisResult.runtime_warning.description }}
                div(*ngIf="analysisResult.runtime_warning.action",
                    class="mt-2 text-[11px] text-amber-700") {{ analysisResult.runtime_warning.action }}

        //- 알림 워크플로
        div(*ngIf="alertWorkflow",
            class="mt-4 bg-amber-50 border border-amber-200 rounded-xl p-4")
            div(class="flex items-center gap-2 mb-2")
                span(class="text-sm") 🔔
                span(class="text-[13px] font-medium text-amber-800") 알림 발송 대기
            div(class="text-xs text-zinc-600 mb-2") {{ alertWorkflow.protocol_headline }}
            button(*ngIf="alertWorkflow.emergency?.popup_required",
                (click)="emergencyPopupOpen = true",
                class="text-xs px-3 py-1 bg-rose-600 text-white rounded-lg hover:bg-rose-700") 🚨 응급 프로토콜

    //- ── 분석 결과 상세 ──
    div(class="space-y-6")
        //- 분석 요약
        div(*ngIf="analysisResult.analysis_overview",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="text-[13px] font-semibold text-zinc-800 mb-2") 분석 요약
            div(*ngFor="let line of analysisResult.analysis_overview",
                class="text-[13px] text-zinc-600 leading-relaxed") {{ line }}

        div(*ngIf="uploadChunkSummary || uploadLogEntries.length > 0",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="flex items-center justify-between gap-3")
                div
                    div(class="text-[13px] font-semibold text-zinc-800") 업로드 분할 로그
                    p(class="mt-1 text-xs text-zinc-500", *ngIf="prototypeInfo?.chunk_policy?.upload") {{ prototypeInfo?.chunk_policy?.upload?.headline }}
                span(class="text-xs text-zinc-400") {{ uploadLogEntries.length }}건
            div(class="mt-3 rounded-xl border border-indigo-100 bg-indigo-50 px-3 py-2 text-[11px] text-indigo-800", *ngIf="uploadChunkSummary?.line") {{ uploadChunkSummary?.line }}
            div(class="mt-4 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-3", *ngIf="uploadLogEntries.length > 0")
                div(class="flex items-center justify-between gap-2")
                    p(class="text-[11px] font-semibold text-zinc-700") 분할 타임라인
                    p(class="text-[10px] text-zinc-500") 중첩 청크를 한눈에 확인합니다
                div(class="mt-3 relative h-16 rounded-lg border border-zinc-200 bg-white overflow-hidden")
                    div(class="absolute inset-x-0 top-1/2 h-px bg-zinc-200")
                    div(*ngFor="let entry of uploadLogEntries; let idx = index",
                        class="absolute top-2 h-5 rounded-md border px-2 text-[10px] font-medium leading-5 shadow-sm overflow-hidden whitespace-nowrap",
                        [ngClass]="entry.level === 'high' ? 'border-rose-200 bg-rose-100 text-rose-700' : (entry.level === 'medium' ? 'border-amber-200 bg-amber-100 text-amber-700' : 'border-emerald-200 bg-emerald-100 text-emerald-700')",
                        [style.left]="chunkBarLeft(entry, chunkTimelineTotal(uploadLogEntries, uploadChunkSummary?.max_end_sec || 0))",
                        [style.width]="chunkBarWidth(entry, chunkTimelineTotal(uploadLogEntries, uploadChunkSummary?.max_end_sec || 0))",
                        [style.top]="(idx % 2) === 0 ? '8px' : '34px'") {{ entry.chunkLabel || entry.label }}
            div(class="mt-4 space-y-2")
                div(*ngIf="uploadLogEntries.length === 0",
                    class="rounded-xl border border-dashed border-zinc-200 px-4 py-6 text-center text-xs text-zinc-400") 분할 로그가 아직 생성되지 않았습니다.
                div(*ngFor="let entry of uploadLogEntries",
                    (click)="openLogDetail(entry)",
                    class="rounded-xl border border-zinc-200 px-3 py-3 transition-colors cursor-pointer hover:bg-zinc-50")
                    div(class="flex items-start gap-3")
                        div(class="mt-1 h-2 w-2 rounded-full shrink-0",
                            [ngClass]="logRiskDotClass(entry.level)")
                        div(class="flex-1 min-w-0")
                            div(class="flex items-center gap-2 flex-wrap")
                                span(class="text-[12px] font-semibold", [ngClass]="logRiskClass(entry.level)") {{ entry.chunkLabel || entry.label }}
                                span(class="text-[11px] text-zinc-500") {{ (entry.score * 100) | number:'1.0-0' }}%
                                span(*ngIf="entry.postureLabel", class="text-[11px] text-sky-600") {{ entry.postureLabel }}
                                span(*ngIf="entry.facialLabel", class="text-[11px] text-cyan-600") 표정 {{ entry.facialLabel }} {{ entry.facialPercent }}%
                                span(*ngIf="entry.chunkWindow?.start_sec != null && entry.chunkWindow?.end_sec != null", class="text-[10px] rounded-full bg-zinc-100 px-2 py-0.5 text-zinc-500") {{ entry.chunkWindow?.start_sec }}s → {{ entry.chunkWindow?.end_sec }}s
                            div(*ngIf="entry.oneLine", class="mt-1 text-[11px] text-zinc-700 truncate") {{ entry.oneLine }}
                            div(*ngIf="entry.basis", class="mt-1 text-[10px] text-zinc-500 truncate") {{ entry.basis }}

        //- 위험 점수 상세
        div(class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="text-[13px] font-semibold text-zinc-800 mb-2") 위험 점수 산출
            div(class="text-xs text-zinc-500 mb-3") 산출식: {{ getRiskScoreFormula() }}
            div(class="h-3 rounded-full bg-zinc-100 overflow-hidden")
                div(class="h-full rounded-full transition-all",
                    [class.bg-emerald-500]="analysisResult.risk_level === 'low'",
                    [class.bg-amber-500]="analysisResult.risk_level === 'medium'",
                    [class.bg-rose-500]="analysisResult.risk_level === 'high'",
                    [style.width.%]="riskScorePercent()")

        //- Dual-Mode Posture & Decision (xg-dual or rf-dual)
        div(*ngIf="isDualModeResult() && hasPostureData()",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="text-[13px] font-semibold text-zinc-800 mb-3") 자세 분류 & 판정
            //- 6-class 확률 바
            div(class="space-y-2 mb-4")
                div(*ngFor="let item of postureItems()",
                    class="flex items-center gap-2",
                    [class.bg-zinc-50]="item.active",
                    class="rounded-lg px-2 py-1")
                    span(class="text-sm w-5") {{ item.icon }}
                    span(class="text-[13px] w-12",
                        [class.font-semibold]="item.active") {{ item.label }}
                    div(class="flex-1 h-2 rounded-full bg-zinc-100 overflow-hidden")
                        div(class="h-full rounded-full bg-sky-500 transition-all",
                            [style.width.%]="item.percent")
                    span(class="text-xs text-zinc-500 w-10 text-right") {{ item.percent }}%
            //- Decision State
            div(class="flex items-center gap-2 mb-2")
                span(class="text-xs text-zinc-500") 판정:
                span(class="text-xs px-2 py-0.5 rounded-full border",
                    [ngClass]="decisionStateMeta().badgeCls") {{ decisionStateMeta().icon }} {{ decisionStateMeta().label }}
            //- 불확실 경고
            div(*ngIf="isAmbiguousDecision()",
                class="bg-violet-50 border border-violet-200 rounded-lg p-2 text-xs text-violet-700 mt-2") ⚠ 판정이 불확실합니다. 피드백으로 모델 정확도를 개선해 주세요.
            //- Explain items
            div(*ngIf="getExplainItems().length > 0",
                class="mt-3")
                div(class="text-xs text-zinc-500 mb-1") 판단 근거
                div(*ngFor="let ex of getExplainItems()",
                    class="text-xs text-zinc-600 pl-3 border-l-2 border-zinc-200 mb-1") {{ ex }}
            //- Guard 억제 배지
            div(*ngIf="getSuppressedBy().length > 0",
                class="mt-2 flex items-center gap-1 flex-wrap")
                span(*ngFor="let s of getSuppressedBy()",
                    class="text-[10px] px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 border border-zinc-200") 🛡 {{ s }}

        //- 표정 분석 결과
        div(*ngIf="hasFacialStateAux()",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="flex items-center justify-between gap-3 mb-3")
                div
                    div(class="text-[13px] font-semibold text-zinc-800") 표정 분석
                    div(class="text-xs text-zinc-500 mt-1") {{ facialStateAuxText() }}
                div(class="text-right")
                    div(class="text-2xl font-bold text-zinc-900") {{ facialStatePercent() }}%
                    div(class="text-[10px] text-zinc-400") 얼굴 신뢰도
            div(class="space-y-2")
                div(*ngFor="let item of facialStateItems()",
                    class="flex items-center gap-2 rounded-lg px-2 py-1",
                    [class.bg-zinc-50]="item.active")
                    span(class="text-[13px] w-14",
                        [class.font-semibold]="item.active") {{ item.label }}
                    div(class="flex-1 h-2 rounded-full bg-zinc-100 overflow-hidden")
                        div(class="h-full rounded-full transition-all",
                            [style.width.%]="item.percent",
                            [style.background]="item.color")
                    span(class="text-xs text-zinc-500 w-10 text-right") {{ item.percent }}%
            div(class="mt-3 grid grid-cols-3 gap-2 text-[11px] text-zinc-500")
                div(class="rounded-lg bg-zinc-50 border border-zinc-100 px-2 py-1")
                    div(class="font-semibold text-zinc-700") {{ facialStateAux()?.detections || 0 }}
                    div 검출 프레임
                div(class="rounded-lg bg-zinc-50 border border-zinc-100 px-2 py-1")
                    div(class="font-semibold text-zinc-700") {{ ((facialStateAux()?.support_score || 0) * 100) | number:'1.0-0' }}%p
                    div 보조 점수
                div(class="rounded-lg bg-zinc-50 border border-zinc-100 px-2 py-1")
                    div(class="font-semibold text-zinc-700") {{ facialStateAux()?.analysis_mode || '-' }}
                    div 반영 모드
            div(*ngIf="facialEvidenceLines().length > 0",
                class="mt-3 rounded-lg border border-zinc-100 bg-zinc-50 px-3 py-2")
                div(class="text-[11px] font-semibold text-zinc-700 mb-1") 표정 판단 근거
                div(*ngFor="let line of facialEvidenceLines()",
                    class="text-[11px] leading-5 text-zinc-600") {{ line }}

        //- 판단 근거 카드
        div(*ngIf="sortedAnalysisBasis().length > 0",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="text-[13px] font-semibold text-zinc-800 mb-3") 판단 근거
            div(class="grid md:grid-cols-2 gap-3")
                div(*ngFor="let item of sortedAnalysisBasis()",
                    class="rounded-lg border p-3",
                    [ngClass]="basisCardClass(item)")
                    div(class="flex items-center justify-between mb-1")
                        span(class="text-[13px] font-medium text-zinc-800") {{ item.label }}
                        span(*ngIf="item.contribution_rank",
                            class="text-[10px] text-zinc-400") {{ '#' + item.contribution_rank }}
                    div(class="text-xs text-zinc-600") {{ item.value }} {{ item.unit }}
                    div(*ngIf="item.description",
                        class="text-[10px] text-zinc-400 mt-1") {{ item.description }}

        //- 모델 런타임
        div(*ngIf="analysisResult.model_runtime",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="text-[13px] font-semibold text-zinc-800 mb-2") 모델 런타임
            div(class="grid grid-cols-2 gap-2 text-xs")
                div(class="text-zinc-500") 엔진
                div(class="text-zinc-700") {{ analysisResult.model_runtime.label }}
                div(*ngIf="runtimeRfModelPath()")
                    span(class="text-zinc-500") RF 모델
                div(*ngIf="runtimeRfModelPath()",
                    class="break-all text-zinc-700") {{ runtimeRfModelPath() }}
                div(*ngIf="runtimePostureClassifierPath()")
                    span(class="text-zinc-500") Posture 모델
                div(*ngIf="runtimePostureClassifierPath()",
                    class="break-all text-zinc-700") {{ runtimePostureClassifierPath() }}
                div(*ngIf="analysisResult.model_runtime.extracted_frames != null")
                    span(class="text-zinc-500") 추출 프레임
                div(*ngIf="analysisResult.model_runtime.extracted_frames != null")
                    span(class="text-zinc-700") {{ analysisResult.model_runtime.extracted_frames }}
                div(*ngIf="analysisResult.model_runtime.detected_person_frames != null")
                    span(class="text-zinc-500") 사람 검출 프레임
                div(*ngIf="analysisResult.model_runtime.detected_person_frames != null")
                    span(class="text-zinc-700") {{ analysisResult.model_runtime.detected_person_frames }}
                div(*ngIf="analysisResult.model_runtime.processed_frames != null")
                    span(class="text-zinc-500") 처리 프레임
                div(*ngIf="analysisResult.model_runtime.processed_frames != null")
                    span(class="text-zinc-700") {{ analysisResult.model_runtime.processed_frames }}
                div(*ngIf="analysisResult.model_runtime.windows != null")
                    span(class="text-zinc-500") 분석 윈도우
                div(*ngIf="analysisResult.model_runtime.windows != null")
                    span(class="text-zinc-700") {{ analysisResult.model_runtime.windows }}

        //- 서버 타이밍 E2E
        div(*ngIf="analysisResult.server_timing",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="text-[13px] font-semibold text-zinc-800 mb-2") 처리 시간 상세
            div(class="space-y-1")
                div(*ngFor="let item of getServerTimingDetail()",
                    class="flex items-center gap-2 text-xs")
                    span(class="w-24 text-zinc-500") {{ item.label }}
                    div(class="flex-1 h-1.5 rounded-full bg-zinc-100 overflow-hidden")
                        div(class="h-full rounded-full bg-blue-400",
                            [style.width.%]="(item.value / (analysisResult.server_timing.total_server_sec || 1)) * 100")
                    span(class="w-12 text-right text-zinc-500") {{ item.value | number:'1.2-2' }}초

        //- 검출 리플레이
        div(*ngIf="getDetectionFrames().length > 0",
            class="bg-white rounded-xl border border-zinc-200 p-4")
            div(class="flex items-center justify-between mb-2")
                div(class="text-[13px] font-semibold text-zinc-800") 검출 리플레이
                button((click)="toggleDetectionReplay()",
                    class="text-xs px-3 py-1 rounded-lg border border-zinc-200 hover:bg-zinc-50")
                    span(*ngIf="!detectionReplayPlaying") ▶ 재생
                    span(*ngIf="detectionReplayPlaying") ⏸ 정지
            div(class="text-xs text-zinc-500 mb-1") 프레임 {{ detectionReplayIndex + 1 }} / {{ getDetectionFrames().length }}
            input(type="range", min="0",
                [max]="getDetectionFrames().length - 1",
                [value]="detectionReplayIndex",
                (input)="seekDetectionReplay($event.target.value)",
                class="w-full accent-blue-500")

    //- ── 2-Level 피드백 (업로드 모드) ──
    div(*ngIf="analysisResult && inputMode !== 'webcam'",
        class="mt-6 bg-white rounded-xl border border-zinc-200 p-4")
        div(class="text-[13px] font-semibold text-zinc-800 mb-3") 결과 피드백
        //- Level 1: 낙상 판정
        div(class="mb-3")
            div(class="text-xs text-zinc-500 mb-2") 낙상 판정이 맞나요?
            div(class="flex gap-2")
                button((click)="feedbackStatus = 'correct'",
                    class="px-4 py-2 rounded-lg border text-[13px] transition-colors",
                    [class.bg-emerald-50]="feedbackStatus === 'correct'",
                    [class.border-emerald-300]="feedbackStatus === 'correct'",
                    [class.text-emerald-700]="feedbackStatus === 'correct'",
                    [class.border-zinc-200]="feedbackStatus !== 'correct'") ✅ 맞음
                button((click)="feedbackStatus = 'incorrect'; feedbackActualLabel = analysisResult?.fall_detected ? 'N' : 'Y'",
                    class="px-4 py-2 rounded-lg border text-[13px] transition-colors",
                    [class.bg-rose-50]="feedbackStatus === 'incorrect'",
                    [class.border-rose-300]="feedbackStatus === 'incorrect'",
                    [class.text-rose-700]="feedbackStatus === 'incorrect'",
                    [class.border-zinc-200]="feedbackStatus !== 'incorrect'") ❌ 틀림
        //- Level 2: 자세 6-class
        div(*ngIf="feedbackStatus",
            class="mb-3")
            div(class="text-xs text-zinc-500 mb-2") 실제 자세는? (선택)
            div(class="flex flex-wrap gap-2")
                button(*ngFor="let pc of postureClasses",
                    (click)="feedbackPostureClass = feedbackPostureClass === pc.code ? '' : pc.code",
                    class="px-3 py-1.5 rounded-lg border text-xs transition-colors",
                    [class.bg-sky-50]="feedbackPostureClass === pc.code",
                    [class.border-sky-300]="feedbackPostureClass === pc.code",
                    [class.border-zinc-200]="feedbackPostureClass !== pc.code") {{ pc.icon }} {{ pc.label }}
        //- 추가 태그
        div(*ngIf="feedbackStatus",
            class="mb-3 flex flex-wrap gap-2")
            label(class="flex items-center gap-1 text-xs text-zinc-600 cursor-pointer")
                input(type="checkbox",
                    [checked]="feedbackAmbiguityFlag",
                    (change)="toggleFeedbackFlag('ambiguity')")
                span 애매한 영상
            label(class="flex items-center gap-1 text-xs text-zinc-600 cursor-pointer")
                input(type="checkbox",
                    [checked]="feedbackOcclusionFlag",
                    (change)="toggleFeedbackFlag('occlusion')")
                span 가림/폐색
            label(class="flex items-center gap-1 text-xs text-zinc-600 cursor-pointer")
                input(type="checkbox",
                    [checked]="feedbackShortClipFlag",
                    (change)="toggleFeedbackFlag('short_clip')")
                span 짧은 영상
            label(class="flex items-center gap-1 text-xs text-zinc-600 cursor-pointer")
                input(type="checkbox",
                    [checked]="feedbackRetrainRequested",
                    (change)="feedbackRetrainRequested = !feedbackRetrainRequested")
                span 제출 후 재학습 시도
        //- 메모 + 제출
        div(*ngIf="feedbackStatus",
            class="space-y-2")
            textarea([(ngModel)]="feedbackNote",
                placeholder="추가 메모 (선택)",
                rows="2",
                class="w-full text-xs border border-zinc-200 rounded-lg p-2 resize-none")
            button((click)="submitAnalysisFeedback()",
                [disabled]="feedbackSubmitting",
                class="px-4 py-2 rounded-lg bg-blue-600 text-white text-[13px] font-medium hover:bg-blue-700 disabled:opacity-50")
                span(*ngIf="!feedbackSubmitting") 피드백 제출
                span(*ngIf="feedbackSubmitting") 저장 중... {{ feedbackElapsedSec }}초
        //- 피드백 메시지
        div(*ngIf="feedbackMessage",
            class="mt-2 text-xs rounded-lg p-2",
            [class.bg-emerald-50]="feedbackMessageType === 'success'",
            [class.text-emerald-700]="feedbackMessageType === 'success'",
            [class.bg-rose-50]="feedbackMessageType === 'error'",
            [class.text-rose-700]="feedbackMessageType === 'error'") {{ feedbackMessage }}

//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//- 하단 바로가기 (업로드 모드만)
//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
section(*ngIf="inputMode !== 'webcam'",
    class="py-8 bg-zinc-50")
    div(class="max-w-[1800px] mx-auto px-4 sm:px-6")
        div(class="grid md:grid-cols-3 gap-4")
            div((click)="goPipelinePage()",
                class="bg-white rounded-xl border border-zinc-200 p-4 cursor-pointer hover:shadow-sm transition-shadow")
                div(class="text-sm mb-1") 🔬
                div(class="text-[13px] font-medium text-zinc-800") AI 파이프라인
                div(class="text-xs text-zinc-400") 모델 흐름도 확인
            div((click)="goManualPage()",
                class="bg-white rounded-xl border border-zinc-200 p-4 cursor-pointer hover:shadow-sm transition-shadow")
                div(class="text-sm mb-1") 📖
                div(class="text-[13px] font-medium text-zinc-800") 사용 설명서
                div(class="text-xs text-zinc-400") 시스템 가이드
            div((click)="goAdminPage()",
                class="bg-white rounded-xl border border-zinc-200 p-4 cursor-pointer hover:shadow-sm transition-shadow")
                div(class="text-sm mb-1") ⚙️
                div(class="text-[13px] font-medium text-zinc-800") 관리자 설정
                div(class="text-xs text-zinc-400") 알림/학습 설정

//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//- 로그 상세 팝업 모달
//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
div(*ngIf="logDetailOpen && logDetailEntry",
    class="fixed inset-0 z-50 flex items-center justify-center",
    style="background:rgba(0,0,0,0.6)",
    (click)="closeLogDetail()")
    div(class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto",
        (click)="$event.stopPropagation()")
        div(class="p-4 border-b border-zinc-200 flex items-center justify-between")
            div(class="text-[13px] font-semibold text-zinc-800") {{ '분석 상세 #' + logDetailEntry.id }}
            button((click)="closeLogDetail()",
                class="text-zinc-400 hover:text-zinc-600 text-lg") ✕
        div(class="p-4 space-y-3")
            div(*ngIf="logDetailEntry.chunkLabel",
                class="rounded-lg border border-indigo-100 bg-indigo-50 px-3 py-2 text-xs text-indigo-800") {{ logDetailEntry.chunkLabel }} 구간 상세입니다.
            div(*ngIf="logDetailVideoMode === 'upload' && logDetailRangeLabel()",
                class="rounded-lg border border-sky-100 bg-sky-50 px-3 py-2 text-xs text-sky-800") 원본 영상에서 {{ logDetailRangeLabel() }} 구간만 재생합니다.
            //- 영상 프리뷰
            div(*ngIf="logDetailVideoLoading",
                class="rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-3 text-xs text-zinc-500") 부분 영상을 준비하는 중입니다...
            video(*ngIf="logDetailVideoUrl && canShowRawVideo()", #logDetailVideo="",
                [src]="logDetailVideoUrl",
                controls="",
                preload="metadata",
                (loadedmetadata)="onLogDetailVideoLoaded(logDetailVideo)",
                (timeupdate)="onLogDetailVideoTimeUpdate(logDetailVideo)",
                (error)="onLogDetailVideoError()",
                class="w-full rounded-xl bg-black max-h-64 object-contain")
            div(*ngIf="logDetailVideoUrl && !canShowRawVideo()",
                class="rounded-xl border border-zinc-200 bg-zinc-950 px-3 py-8 text-center text-xs text-zinc-300")
                div(class="text-[13px] font-semibold") 스켈레톤 전용 보기
                div(class="mt-1 text-[11px] text-zinc-500") 원본 영상은 원본 모드에서만 표시됩니다.
            div(*ngIf="!logDetailVideoLoading && logDetailVideoError",
                class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700") {{ logDetailVideoError }}
            //- 점수
            div(class="flex items-center gap-3")
                div(class="text-2xl font-bold",
                    [ngClass]="riskClass(logDetailEntry.level)") {{ (logDetailEntry.score * 100) | number:'1.0-0' }}%
                div
                    div(class="text-xs",
                        [ngClass]="riskClass(logDetailEntry.level)") {{ logDetailEntry.label }}
                    div(class="text-[10px] text-zinc-400") {{ logDetailEntry.timestamp }} · {{ logDetailEntry.elapsed | number:'1.1-1' }}초
            div(*ngIf="logDetailEntry.oneLine",
                class="text-xs text-zinc-700 bg-indigo-50 rounded-lg p-2 border border-indigo-100") {{ logDetailEntry.oneLine }}
            //- 판단 근거 요약
            div(*ngIf="logDetailEntry.basis",
                class="text-xs text-zinc-600 bg-zinc-50 rounded-lg p-2") {{ logDetailEntry.basis }}
            //- 판정 상태
            div(*ngIf="logDetailEntry.decisionState && logDetailEntry.decisionState !== 'safe'",
                class="flex items-center gap-2")
                span(class="text-xs px-2 py-0.5 rounded-full border",
                    [ngClass]="DECISION_STATE_META[logDetailEntry.decisionState]?.badgeCls || ''") {{ DECISION_STATE_META[logDetailEntry.decisionState]?.icon }} {{ DECISION_STATE_META[logDetailEntry.decisionState]?.label }}
            //- 판단 근거 (from result)
            div(*ngIf="logDetailEntry.result?.analysis_basis",
                class="space-y-1")
                div(*ngFor="let item of logDetailEntry.result.analysis_basis | slice:0:4",
                    class="text-xs text-zinc-600") {{ item.label }}: {{ item.value }} {{ item.unit }}
            //- 자세 정보
            div(*ngIf="logDetailEntry.result?.posture_label",
                class="flex items-center gap-2")
                span(class="text-xs text-zinc-500") 자세:
                span(class="text-xs font-medium") {{ POSTURE_LABEL_MAP[logDetailEntry.result.posture_label] || logDetailEntry.result.posture_label }}
            //- 표정 정보
            div(*ngIf="hasFacialStateAux(logDetailEntry.result)",
                class="rounded-lg border border-cyan-100 bg-cyan-50 px-3 py-2")
                div(class="flex items-center justify-between gap-2")
                    span(class="text-xs font-semibold text-cyan-900") 표정 분석
                    span(class="text-xs text-cyan-700") {{ facialStatePercent(logDetailEntry.result) }}%
                div(class="mt-1 text-xs text-cyan-800") {{ facialStateLabel(logDetailEntry.result) }}
                div(class="mt-1 text-[10px] leading-4 text-cyan-700") {{ facialStateAuxText(logDetailEntry.result) }}
            //- 로그 피드백
            div(*ngIf="!logDetailEntry.feedbackDone",
                class="border-t border-zinc-200 pt-3 space-y-2")
                div(class="text-xs text-zinc-500") 이 분석 결과가 맞나요?
                div(class="flex gap-2")
                    button((click)="logFeedbackStatus = 'correct'",
                        class="px-3 py-1 rounded-lg border text-xs",
                        [class.bg-emerald-50]="logFeedbackStatus === 'correct'",
                        [class.border-emerald-300]="logFeedbackStatus === 'correct'",
                        [class.border-zinc-200]="logFeedbackStatus !== 'correct'") ✅ 맞음
                    button((click)="logFeedbackStatus = 'incorrect'; logFeedbackActualLabel = logDetailEntry.result?.fall_detected ? 'N' : 'Y'",
                        class="px-3 py-1 rounded-lg border text-xs",
                        [class.bg-rose-50]="logFeedbackStatus === 'incorrect'",
                        [class.border-rose-300]="logFeedbackStatus === 'incorrect'",
                        [class.border-zinc-200]="logFeedbackStatus !== 'incorrect'") ❌ 틀림
                //- 자세 선택
                div(*ngIf="logFeedbackStatus",
                    class="flex flex-wrap gap-1")
                    button(*ngFor="let pc of postureClasses",
                        (click)="setLogFeedbackPostureClass(pc.code)",
                        class="px-2 py-1 rounded border text-[10px]",
                        [class.bg-sky-50]="logFeedbackPostureClass === pc.code",
                        [class.border-sky-300]="logFeedbackPostureClass === pc.code",
                        [class.border-zinc-200]="logFeedbackPostureClass !== pc.code") {{ pc.icon }} {{ pc.label }}
                //- 태그
                div(*ngIf="logFeedbackStatus",
                    class="flex flex-wrap gap-2")
                    label(class="flex items-center gap-1 text-[10px] text-zinc-600 cursor-pointer")
                        input(type="checkbox",
                            [checked]="logFeedbackAmbiguityFlag",
                            (change)="toggleLogFeedbackFlag('ambiguity')")
                        span 애매함
                    label(class="flex items-center gap-1 text-[10px] text-zinc-600 cursor-pointer")
                        input(type="checkbox",
                            [checked]="logFeedbackOcclusionFlag",
                            (change)="toggleLogFeedbackFlag('occlusion')")
                        span 가림
                    label(class="flex items-center gap-1 text-[10px] text-zinc-600 cursor-pointer")
                        input(type="checkbox",
                            [checked]="logFeedbackShortClipFlag",
                            (change)="toggleLogFeedbackFlag('short_clip')")
                        span 짧은영상
                    label(class="flex items-center gap-1 text-[10px] text-zinc-600 cursor-pointer")
                        input(type="checkbox",
                            [checked]="logFeedbackRetrainRequested",
                            (change)="logFeedbackRetrainRequested = !logFeedbackRetrainRequested")
                        span 재학습
                //- 메모 + 제출
                div(*ngIf="logFeedbackStatus")
                    textarea([(ngModel)]="logFeedbackNote",
                        placeholder="메모 (선택)",
                        rows="1",
                        class="w-full text-[10px] border border-zinc-200 rounded p-1 resize-none mb-1")
                    button((click)="submitLogFeedback()",
                        [disabled]="logFeedbackSubmitting",
                        class="px-3 py-1 rounded-lg bg-blue-600 text-white text-xs hover:bg-blue-700 disabled:opacity-50")
                        span(*ngIf="!logFeedbackSubmitting") 피드백 제출
                        span(*ngIf="logFeedbackSubmitting") 저장 중... {{ logFeedbackElapsedSec }}초
                    div(*ngIf="logFeedbackMessage",
                        class="mt-1 text-[10px] rounded p-1",
                        [class.bg-emerald-50]="logFeedbackMessageType === 'success'",
                        [class.text-emerald-700]="logFeedbackMessageType === 'success'",
                        [class.bg-rose-50]="logFeedbackMessageType === 'error'",
                        [class.text-rose-700]="logFeedbackMessageType === 'error'") {{ logFeedbackMessage }}
            div(*ngIf="logDetailEntry.feedbackDone",
                class="text-xs text-emerald-600 border-t border-zinc-200 pt-3") ✅ 피드백 완료

//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//- 기준 영상 팝업
//- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
div(*ngIf="referencePopupOpen",
    class="fixed inset-0 z-50 flex items-center justify-center",
    style="background:rgba(0,0,0,0.6)",
    (click)="closeReferencePopup()")
    div(class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden",
        (click)="$event.stopPropagation()")
        div(class="p-4 border-b border-zinc-200 flex items-center justify-between")
            span(class="text-[13px] font-semibold text-zinc-800") 기준 영상
            button((click)="closeReferencePopup()",
                class="text-zinc-400 hover:text-zinc-600 text-lg") ✕
        div(class="p-4")
