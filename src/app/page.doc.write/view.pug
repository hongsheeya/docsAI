div.w-full.h-full.overflow-auto.bg-white
    div(class="max-w-[1480px] mx-auto p-6")
        div(class="bg-[#080808] rounded-lg p-6 mb-6 text-white shadow-[0_30px_18px_rgba(0,0,0,0.08),0_3px_7px_rgba(0,0,0,0.09)]")
            div.flex.items-end.justify-between.gap-5
                div
                    div(class="text-[12px] uppercase tracking-[1.5px] text-white/60 mb-2") Document Workspace
                    h1(class="text-[32px] leading-[1.12] font-semibold mb-2") 문서 작성 워크스페이스
                    p(class="text-white/70 text-[14px] leading-6 max-w-2xl") 양식을 먼저 이해하고, 본문/그래프/이미지를 만든 뒤, 원본 레이아웃 위에 정확히 배치합니다.
                div(class="flex items-center gap-2 flex-wrap justify-end")
                    button((click)="openCreateFolder()",
                        class="px-4 py-2.5 border border-white/25 text-white text-[13px] font-medium rounded hover:bg-white/10 transition-colors flex-shrink-0") 새 폴더
                    button((click)="openBulk()",
                        class="px-4 py-2.5 border border-white/25 text-white text-[13px] font-medium rounded hover:bg-white/10 transition-colors flex-shrink-0") 주차 일괄 생성
                    button((click)="openCompletedUpload()",
                        class="px-4 py-2.5 border border-white/25 text-white text-[13px] font-medium rounded hover:bg-white/10 transition-colors flex-shrink-0") 외부 파일 업로드
                    button((click)="openNew()",
                        class="px-5 py-2.5 bg-white text-[#080808] text-[13px] font-medium rounded hover:bg-slate-100 transition-colors flex-shrink-0") 새 문서 작성

        div(class="grid grid-cols-3 gap-4 mb-6")
            div(class="bg-white rounded-lg border border-[#d8d8d8] p-5 relative overflow-hidden")
                div(class="absolute left-0 top-0 h-1 w-full bg-[#7a3dff]")
                div(class="text-[12px] uppercase tracking-[.6px] text-[#898989] mb-1") Total
                div(class="text-[28px] leading-none font-semibold text-[#080808]") {{ stats.total }}
            div(class="bg-white rounded-lg border border-[#d8d8d8] p-5 relative overflow-hidden")
                div(class="absolute left-0 top-0 h-1 w-full bg-[#ffae13]")
                div(class="text-[12px] uppercase tracking-[.6px] text-[#898989] mb-1") In Progress
                div(class="text-[28px] leading-none font-semibold text-[#080808]") {{ stats.in_progress }}
            div(class="bg-white rounded-lg border border-[#d8d8d8] p-5 relative overflow-hidden")
                div(class="absolute left-0 top-0 h-1 w-full bg-[#00d722]")
                div(class="text-[12px] uppercase tracking-[.6px] text-[#898989] mb-1") Done
                div(class="text-[28px] leading-none font-semibold text-[#080808]") {{ stats.done }}

        div(class="grid grid-cols-12 gap-6")
            div(class="col-span-3")
                div(class="bg-white rounded-lg border border-[#d8d8d8] p-4 sticky top-6")
                    div(class="flex items-center justify-between mb-3")
                        h2(class="text-[12px] uppercase tracking-[1.5px] font-medium text-[#5a5a5a]") Folders
                        button((click)="openCreateFolder()",
                            class="text-xs text-[#080808] font-medium hover:underline") 새 폴더

                    div(class="space-y-1")
                        button((click)="selectFolder('__all__')",
                            class="w-full text-left px-3 py-2 rounded text-[13px] transition-colors",
                            [ngClass]="selectedFolderId === '__all__' ? 'bg-[#080808] text-white' : 'text-[#363636] hover:bg-slate-50'")
                            span 전체 문서
                        button((click)="selectFolder('')",
                            class="w-full text-left px-3 py-2 rounded text-[13px] transition-colors",
                            [ngClass]="selectedFolderId === '' ? 'bg-[#080808] text-white' : 'text-[#363636] hover:bg-slate-50'")
                            span 미분류

                        div(*ngFor="let folder of folders",
                            class="group flex items-center gap-2")
                            button((click)="selectFolder(folder.id)",
                                class="flex-1 text-left px-3 py-2 rounded text-[13px] transition-colors",
                                [ngClass]="selectedFolderId === folder.id ? 'bg-[#080808] text-white' : 'text-[#363636] hover:bg-slate-50'")
                                span {{ folder.name }}
                                span(class="ml-2 text-xs opacity-60") {{ folder.doc_count || 0 }}
                            div(class="opacity-0 group-hover:opacity-100 flex items-center gap-1 transition-opacity")
                                button((click)="openRenameFolder(folder); $event.stopPropagation()",
                                    class="text-xs text-[#5a5a5a] hover:text-[#080808]") 수정
                                button((click)="deleteFolder(folder); $event.stopPropagation()",
                                    class="text-xs text-rose-400 hover:text-rose-600") 삭제

            div(class="col-span-9")
                div(class="bg-white rounded-lg border border-[#d8d8d8] overflow-hidden")
                    div(class="px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4")
                        div
                            div(class="text-[12px] uppercase tracking-[1.5px] text-[#898989] mb-1") {{ viewMode === 'weeks' ? 'Weekly Board' : 'Document List' }}
                            h2(class="text-[20px] font-semibold text-[#080808]") {{ selectedFolderName() }}
                            p(class="text-[13px] text-[#5a5a5a] mt-1") 폴더를 선택하면 그 안의 문서를 한 번에 보고, 선택한 문서는 다른 폴더로 모을 수 있습니다.
                        div(class="flex items-center gap-2 flex-wrap justify-end")
                            div(class="flex border border-[#d8d8d8] rounded overflow-hidden")
                                button((click)="switchView('list')",
                                    class="px-3 py-2 text-[12px] border-r border-[#d8d8d8]",
                                    [ngClass]="viewMode === 'list' ? 'bg-[#080808] text-white' : 'bg-white text-[#363636]'") 목록
                                button((click)="switchView('weeks')",
                                    class="px-3 py-2 text-[12px]",
                                    [ngClass]="viewMode === 'weeks' ? 'bg-[#080808] text-white' : 'bg-white text-[#363636]'") 주차별
                            select([(ngModel)]="sortBy",
                                (ngModelChange)="changeSort()",
                                *ngIf="viewMode === 'list'",
                                class="border border-[#d8d8d8] rounded px-3 py-2 text-[13px] text-[#363636] focus:outline-none focus:ring-2 focus:ring-slate-200")
                                option(value="updated") 최근 수정순
                                option(value="created") 생성일순
                                option(value="title") 제목순
                                option(value="status") 상태순
                            select([(ngModel)]="order",
                                (ngModelChange)="changeSort()",
                                *ngIf="viewMode === 'list'",
                                class="border border-[#d8d8d8] rounded px-3 py-2 text-[13px] text-[#363636] focus:outline-none focus:ring-2 focus:ring-slate-200")
                                option(value="DESC") 내림차순
                                option(value="ASC") 오름차순

                    div(*ngIf="viewMode === 'list' && selectedDocCount() > 0",
                        class="px-6 py-3 bg-slate-50 border-b border-slate-100 flex items-center justify-between gap-3 flex-wrap")
                        div(class="text-[13px] text-[#363636]")
                            span(class="font-semibold text-[#080808]") {{ selectedDocCount() }}개
                            span  문서 선택됨
                        div(class="flex items-center gap-2 flex-wrap")
                            select([(ngModel)]="selectedMoveFolderId",
                                class="border border-[#d8d8d8] rounded px-3 py-2 text-[13px] text-[#363636] focus:outline-none focus:ring-2 focus:ring-slate-200")
                                option(value="") 미분류
                                option(*ngFor="let folder of folders", [value]="folder.id") {{ folder.name }}
                            button((click)="moveSelectedToFolder()",
                                class="px-3 py-2 bg-[#080808] text-white text-[12px] rounded hover:bg-[#222222] transition-colors") 선택 문서 이동
                            button((click)="clearSelection()",
                                class="px-3 py-2 border border-[#d8d8d8] text-[#5a5a5a] text-[12px] rounded hover:bg-white transition-colors") 선택 해제

                    div(*ngIf="viewMode === 'list' && instances.length === 0",
                        class="px-6 py-12 text-center")
                        div(class="text-[12px] uppercase tracking-[1.5px] text-[#898989] mb-2") Empty
                        p(class="text-[13px] text-[#5a5a5a]") 선택한 범위에 문서가 없습니다.
                        p(class="text-xs text-[#ababab] mt-1") 새 문서를 만들거나 다른 폴더를 선택하세요.

                    table(*ngIf="viewMode === 'list' && instances.length > 0",
                        class="w-full")
                        thead
                            tr(class="border-b border-slate-100")
                                th(class="px-6 py-3 text-left w-10")
                                    input(type="checkbox",
                                        [checked]="allVisibleSelected()",
                                        (click)="toggleAllVisible($event)",
                                        class="h-4 w-4 align-middle")
                                th(class="px-6 py-3 text-left text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 문서명
                                th(class="px-6 py-3 text-left text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 시작 경로
                                th(class="px-6 py-3 text-left text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 폴더
                                th(class="px-6 py-3 text-left text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 상태
                                th(class="px-6 py-3 text-left text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 생성일
                                th(class="px-6 py-3 text-left text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 주차
                                th(class="px-6 py-3 text-right text-[12px] uppercase tracking-[.6px] font-medium text-[#898989]") 액션
                        tbody
                            tr(*ngFor="let inst of instances",
                                class="border-b border-slate-100 hover:bg-slate-50 cursor-pointer transition-colors",
                                (click)="goDetail(inst.id)")
                                td(class="px-6 py-3",
                                    (click)="$event.stopPropagation()")
                                    input(type="checkbox",
                                        [checked]="isDocSelected(inst.id)",
                                        (click)="toggleDocSelection(inst, $event)",
                                        class="h-4 w-4 align-middle")
                                td(class="px-6 py-3")
                                    div(class="text-[13px] font-medium text-[#080808]") {{ inst.title }}
                                    div(class="text-xs text-[#898989] mt-1") {{ inst.updated?.substring(0, 16) || inst.created?.substring(0, 16) }}
                                td(class="px-6 py-3 text-[13px] text-[#5a5a5a]") {{ sourceLabel(inst.source_type) }}
                                td(class="px-6 py-3 text-[13px] text-[#5a5a5a]") {{ inst.folder_name || '미분류' }}
                                td(class="px-6 py-3")
                                    span(class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium",
                                        [ngClass]="statusClass(inst.status)") {{ statusLabel(inst.status) }}
                                td(class="px-6 py-3 text-[13px] text-[#898989]") {{ inst.created?.substring(0, 10) }}
                                td(class="px-6 py-3 text-[13px] text-[#898989]") {{ inst.week_label || '-' }}
                                td(class="px-6 py-3 text-right",
                                    (click)="$event.stopPropagation()")
                                    div(class="flex items-center justify-end gap-3")
                                        button((click)="openManageDoc(inst)",
                                            class="text-xs text-[#5a5a5a] hover:text-[#080808] transition-colors") 정리
                                        button((click)="removeDoc(inst.id)",
                                            class="text-xs text-rose-400 hover:text-rose-600 transition-colors") 삭제

                    div(*ngIf="viewMode === 'weeks'",
                        class="p-6 space-y-4")
                        div(*ngIf="weeklyGroups.length === 0",
                            class="py-12 text-center")
                            div(class="text-[12px] uppercase tracking-[1.5px] text-[#898989] mb-2") Empty
                            p(class="text-[13px] text-[#5a5a5a]") 주차로 묶을 문서가 없습니다.
                        div(*ngFor="let group of weeklyGroups",
                            class="border border-[#d8d8d8] rounded-lg overflow-hidden")
                            div(class="px-5 py-4 bg-slate-50 border-b border-[#d8d8d8] flex items-center justify-between gap-4")
                                div
                                    div(class="text-[12px] uppercase tracking-[1.5px] text-[#898989] mb-1") Week
                                    h3(class="text-[18px] font-semibold text-[#080808]") {{ group.week_label }}
                                div(class="text-right")
                                    div(class="text-[13px] text-[#5a5a5a]") {{ group.count }}개 문서
                                    div(class="text-xs text-[#898989]") 완료 {{ group.done_count }}개
                            div(class="divide-y divide-slate-100")
                                div(*ngFor="let doc of group.docs",
                                    class="p-5 hover:bg-slate-50 cursor-pointer transition-colors",
                                    (click)="goDetail(doc.id)")
                                    div(class="flex items-start justify-between gap-4")
                                        div(class="min-w-0")
                                            div(class="flex items-center gap-2 mb-1")
                                                span(class="text-[13px] font-medium text-[#080808] truncate") {{ doc.title }}
                                                span(class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium flex-shrink-0",
                                                    [ngClass]="statusClass(doc.status)") {{ statusLabel(doc.status) }}
                                            div(class="text-xs text-[#898989]") {{ doc.folder_name }} · {{ sourceLabel(doc.source_type) }} · {{ doc.updated?.substring(0, 16) || doc.created?.substring(0, 16) }}
                                            p(*ngIf="doc.preview",
                                                class="mt-3 text-[13px] leading-6 text-[#363636] whitespace-pre-line line-clamp-3") {{ doc.preview }}
                                        div(class="text-xs text-[#898989] flex-shrink-0") 섹션 {{ doc.section_count }}

    div(*ngIf="showNewModal",
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm")
        div(class="bg-white rounded-lg shadow-xl w-full max-w-md p-6",
            (click)="$event.stopPropagation()")
            h3(class="text-[15px] font-semibold text-[#080808] mb-5") 새 문서 작성

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 문서 제목 *
                input(type="text",
                    [(ngModel)]="newTitle",
                    placeholder="예: 4월 3주차 주간업무보고",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 주차
                input(type="text",
                    [(ngModel)]="newWeekLabel",
                    placeholder="예: 5월 2주차, 2026-W20",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 폴더
                select([(ngModel)]="newDocFolderId",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                    option(value="") 미분류
                    option(*ngFor="let folder of folders", [value]="folder.id") {{ folder.name }}

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-2") 시작 방법
                div(class="grid grid-cols-3 gap-3")
                    div((click)="sourceType = 'template'; service.render()",
                        class="border-2 rounded-lg p-3 cursor-pointer text-center transition-all text-[13px]",
                        [class.border-slate-900]="sourceType === 'template'",
                        [class.bg-slate-50]="sourceType === 'template'",
                        [class.border-slate-200]="sourceType !== 'template'")
                        div(class="font-semibold text-slate-700") 양식에서 시작
                        div(class="text-xs text-slate-400 mt-1") 등록된 양식 선택
                    div((click)="sourceType = 'upload'; service.render()",
                        class="border-2 rounded-lg p-3 cursor-pointer text-center transition-all text-[13px]",
                        [class.border-slate-900]="sourceType === 'upload'",
                        [class.bg-slate-50]="sourceType === 'upload'",
                        [class.border-slate-200]="sourceType !== 'upload'")
                        div(class="font-semibold text-slate-700") 직접 업로드
                        div(class="text-xs text-slate-400 mt-1") 외부 파일(PDF/HWP/DOC/DOCX)
                    div((click)="sourceType = 'blank'; service.render()",
                        class="border-2 rounded-lg p-3 cursor-pointer text-center transition-all text-[13px]",
                        [class.border-slate-900]="sourceType === 'blank'",
                        [class.bg-slate-50]="sourceType === 'blank'",
                        [class.border-slate-200]="sourceType !== 'blank'")
                        div(class="font-semibold text-slate-700") 자유 작성
                        div(class="text-xs text-slate-400 mt-1") 양식 없이 시작

            div(*ngIf="sourceType === 'template'",
                class="mb-4")
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 양식 선택 *
                select([(ngModel)]="selectedTemplateId",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                    option(value="") 양식을 선택하세요
                    option(*ngFor="let t of templates",
                        [value]="t.id") {{ t.title }} ({{ t.file_type?.toUpperCase() }})

            div(*ngIf="sourceType === 'upload'",
                class="mb-4")
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 파일 업로드 *
                div(class="border-2 border-dashed border-slate-300 rounded-lg p-4 text-center cursor-pointer hover:border-slate-900 transition-colors bg-slate-50",
                    (click)="uploadInput.click()")
                    input(#uploadInput="",
                        type="file",
                        accept=".pdf,.hwp,.doc,.docx",
                        (change)="onFileSelect($event)",
                        class="hidden")
                    div(*ngIf="!selectedFile",
                        class="text-[13px] text-slate-400") PDF, HWP, DOC, DOCX 파일
                    div(*ngIf="selectedFile",
                        class="text-[13px] text-[#080808] font-medium") {{ selectedFile.name }}

            div.flex.justify-end.gap-3
                button((click)="closeNew()",
                    class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 transition-colors") 취소
                button((click)="createDoc()",
                    [disabled]="creating",
                    class="px-4 py-2 bg-[#080808] text-white text-[13px] font-medium rounded hover:bg-[#222222] transition-colors disabled:opacity-50")
                    span(*ngIf="!creating") 시작하기
                    span(*ngIf="creating") 생성 중...

    div(*ngIf="showBulkModal",
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm")
        div(class="bg-white rounded-lg shadow-xl w-full max-w-lg p-6",
            (click)="$event.stopPropagation()")
            h3(class="text-[15px] font-semibold text-[#080808] mb-5") 주차 일괄 생성

            div(class="grid grid-cols-2 gap-4 mb-4")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 시작 주차
                    input(type="number",
                        min="1",
                        [(ngModel)]="bulkStartWeek",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 끝 주차
                    input(type="number",
                        min="1",
                        [(ngModel)]="bulkEndWeek",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 제목 패턴
                input(type="text",
                    [(ngModel)]="bulkTitlePattern",
                    placeholder="예: 1주차 활동보고서",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                div(class="text-xs text-slate-400 mt-1") 예시: {{ bulkPreviewTitle() }} · 사용 가능: {{ '{' }}week{{ '}' }}, {{ '{' }}n{{ '}' }}

            div(class="grid grid-cols-2 gap-4 mb-4")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 폴더
                    select([(ngModel)]="bulkFolderId",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                        option(value="") 미분류
                        option(*ngFor="let folder of folders", [value]="folder.id") {{ folder.name }}
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 시작 방법
                    select([(ngModel)]="bulkSourceType",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                        option(value="template") 양식에서 시작
                        option(value="blank") 자유 작성

            div(*ngIf="bulkSourceType === 'template'",
                class="mb-4")
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 양식
                select([(ngModel)]="bulkTemplateId",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                    option(value="") 양식을 선택하세요
                    option(*ngFor="let t of templates", [value]="t.id") {{ t.title }} ({{ t.file_type?.toUpperCase() }})

            div(class="rounded border border-slate-200 bg-slate-50 p-3 text-[13px] text-[#5a5a5a] mb-5")
                span(class="font-medium text-[#080808]") {{ bulkCount() }}개
                span  문서를 검토 단계로 생성합니다.

            div.flex.justify-end.gap-3
                button((click)="closeBulk()",
                    class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 transition-colors") 취소
                button((click)="createBulkWeeks()",
                    [disabled]="bulkCreating || bulkCount() <= 0",
                    class="px-4 py-2 bg-[#080808] text-white text-[13px] font-medium rounded hover:bg-[#222222] transition-colors disabled:opacity-50")
                    span(*ngIf="!bulkCreating") 생성하기
                    span(*ngIf="bulkCreating") 생성 중...

    div(*ngIf="showCompletedModal",
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm")
        div(class="bg-white rounded-lg shadow-xl w-full max-w-lg p-6",
            (click)="$event.stopPropagation()")
            h3(class="text-[15px] font-semibold text-[#080808] mb-5") 외부 파일 업로드

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 문서 제목
                input(type="text",
                    [(ngModel)]="completedTitle",
                    placeholder="파일명으로 자동 입력됩니다",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")

            div(class="grid grid-cols-2 gap-4 mb-4")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 주차
                    input(type="text",
                        [(ngModel)]="completedWeekLabel",
                        placeholder="예: 1주차",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 폴더
                    select([(ngModel)]="completedFolderId",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                        option(value="") 미분류
                        option(*ngFor="let folder of folders", [value]="folder.id") {{ folder.name }}

            div.mb-5
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 완료 파일
                div(class="border-2 border-dashed border-slate-300 rounded-lg p-5 text-center cursor-pointer hover:border-slate-900 transition-colors bg-slate-50",
                    (click)="completedInput.click()")
                    input(#completedInput="",
                        type="file",
                        accept=".pdf,.hwp,.doc,.docx",
                        (change)="onCompletedFileSelect($event)",
                        class="hidden")
                    div(*ngIf="!completedFile",
                        class="text-[13px] text-slate-400") PDF, HWP, DOC, DOCX 파일
                    div(*ngIf="completedFile",
                        class="text-[13px] text-[#080808] font-medium") {{ completedFile.name }}

            div.flex.justify-end.gap-3
                button((click)="closeCompletedUpload()",
                    class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 transition-colors") 취소
                button((click)="uploadCompletedFile()",
                    [disabled]="uploadingCompleted || !completedFile",
                    class="px-4 py-2 bg-[#080808] text-white text-[13px] font-medium rounded hover:bg-[#222222] transition-colors disabled:opacity-50")
                    span(*ngIf="!uploadingCompleted") 업로드
                    span(*ngIf="uploadingCompleted") 업로드 중...

    div(*ngIf="showFolderModal",
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm")
        div(class="bg-white rounded-lg shadow-xl w-full max-w-sm p-6")
            h3(class="text-[15px] font-semibold text-[#080808] mb-4") {{ folderMode === 'create' ? '폴더 만들기' : '폴더 이름 수정' }}
            input(type="text",
                [(ngModel)]="folderName",
                (keydown.enter)="saveFolder()",
                placeholder="폴더 이름 입력",
                class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200 mb-4")
            div(class="flex justify-end gap-3")
                button((click)="closeFolderModal()",
                    class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 transition-colors") 취소
                button((click)="saveFolder()",
                    class="px-4 py-2 bg-[#080808] text-white text-[13px] font-medium rounded hover:bg-[#222222] transition-colors") 저장

    div(*ngIf="showManageModal",
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 backdrop-blur-sm")
        div(class="bg-white rounded-lg shadow-xl w-full max-w-lg p-6")
            h3(class="text-[15px] font-semibold text-[#080808] mb-5") 문서 정리

            div.mb-4
                label(class="block text-[13px] font-medium text-slate-600 mb-1") 제목
                input(type="text",
                    [(ngModel)]="manageDocForm.title",
                    class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")

            div(class="grid grid-cols-2 gap-4 mb-4")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 주차
                    input(type="text",
                        [(ngModel)]="manageDocForm.week_label",
                        placeholder="예: 5월 2주차",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 마감일
                    input(type="date",
                        [(ngModel)]="manageDocForm.deadline",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")

            div(class="grid grid-cols-2 gap-4 mb-5")
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 상태
                    select([(ngModel)]="manageDocForm.status",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                        option(value="draft") 초안
                        option(value="writing") 작성중
                        option(value="review") 검토
                        option(value="done") 완료
                div
                    label(class="block text-[13px] font-medium text-slate-600 mb-1") 폴더
                    select([(ngModel)]="manageDocForm.folder_id",
                        class="w-full border border-[#d8d8d8] rounded px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-slate-200")
                        option(value="") 미분류
                        option(*ngFor="let folder of folders", [value]="folder.id") {{ folder.name }}

            div(class="flex justify-end gap-3")
                button((click)="closeManageModal()",
                    class="px-4 py-2 border border-slate-300 text-slate-600 text-[13px] rounded-lg hover:bg-slate-50 transition-colors") 취소
                button((click)="saveDocMeta()",
                    [disabled]="savingMeta",
                    class="px-4 py-2 bg-[#080808] text-white text-[13px] font-medium rounded hover:bg-[#222222] transition-colors disabled:opacity-50")
                    span(*ngIf="!savingMeta") 저장
                    span(*ngIf="savingMeta") 저장 중...
