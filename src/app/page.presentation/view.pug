div(class="presentation-root")

    //- ── TOP BAR ───────────────────────────────────────────────────
    div(class="pres-topbar")
        div(class="flex items-center gap-3 min-w-0")
            div(class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-600 text-white shrink-0")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 3.75h16.5M3.75 8.25h16.5m-16.5 4.5h7.5m-7.5 4.5h7.5")
            span(class="text-[13px] font-semibold text-slate-900 truncate hidden sm:block") FallAI 표정·가림 보조 모델 발표
        div(class="flex items-center gap-2")
            span(class="text-xs text-slate-400 tabular-nums") {{current + 1}} / {{total}}
            button(type="button", class="pres-topbtn", (click)="toggleOverview()", [title]="'슬라이드 목록 (Tab)'")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 6h16.5M3.75 12h16.5m-16.5 6h16.5")
            button(type="button", class="pres-topbtn", (click)="toggleFullscreen()",
                [title]="fullscreen ? '전체화면 해제 (F)' : '전체화면 (F)'")
                svg(*ngIf="!fullscreen", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15")
                svg(*ngIf="fullscreen", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25")
            a(routerLink="/", class="pres-topbtn flex items-center gap-1 px-3 text-[13px] font-medium text-slate-600 no-underline")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
                span(class="hidden sm:inline") 나가기

    //- ── PROGRESS BAR ──────────────────────────────────────────────
    div(class="pres-progress-track")
        div(class="pres-progress-fill", [style.width]="progress + '%'")

    //- ── MAIN SLIDE AREA ───────────────────────────────────────────
    div(class="pres-stage", (click)="$event.stopPropagation()")

        //- ── COVER SLIDE ─────────────────────────────────────────
        ng-container(*ngIf="slide.type === 'cover'")
            div(class="slide-cover")
                div(class="slide-cover-inner")
                    span(class="slide-badge-cover") {{slide.badge}}
                    h1(class="slide-cover-title") {{slide.title}}
                    p(class="slide-cover-subtitle") {{slide.subtitle}}
                    div(*ngIf="slide.stats", class="cover-stat-grid")
                        div(*ngFor="let stat of slide.stats", class="cover-stat-card", [ngClass]="toneClass(stat.tone)")
                            span(class="cover-stat-label") {{stat.label}}
                            span(class="cover-stat-value") {{stat.value}}
                    ul(*ngIf="slide.bullets", class="slide-cover-bullets")
                        li(*ngFor="let b of slide.bullets", class="slide-cover-bullet-item") {{b}}
                    p(*ngIf="slide.meta", class="slide-cover-meta") {{slide.meta}}

        //- ── PROFESSOR FEEDBACK FLOW SLIDE ───────────────────────
        ng-container(*ngIf="slide.type === 'feedback'")
            div(class="slide-content visual-slide feedback-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="feedback-grid")
                    div(*ngFor="let item of slide.items", class="feedback-card", [ngClass]="toneClass(item.tone)")
                        div(class="feedback-card-head")
                            span(class="feedback-status") {{item.status}}
                            strong {{item.label}}
                        div(class="feedback-pair")
                            span 요청
                            p {{item.request}}
                        div(class="feedback-pair")
                            span 반영
                            p {{item.response}}
                div(class="feedback-summary-row")
                    div(*ngFor="let s of slide.summary", class="feedback-summary-card")
                        span {{s.label}}
                        strong {{s.value}}

        //- ── DATA SOURCE PROOF SLIDE ─────────────────────────────
        ng-container(*ngIf="slide.type === 'sourceproof'")
            div(class="slide-content visual-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="source-card-grid")
                    div(*ngFor="let card of slide.cards", class="source-card", [ngClass]="toneClass(card.tone)")
                        div(class="source-shot")
                            div(class="source-year") {{card.year}}
                            div(class="source-figure")
                                div(class="source-person")
                                div(class="source-motion-line line-a")
                                div(class="source-motion-line line-b")
                            div(class="source-tags")
                                span(*ngFor="let tag of card.tags") {{tag}}
                            h3(class="source-title") {{card.title}}
                            div(class="source-meta-grid")
                                div
                                    span 분야
                                    strong 영상이미지·멀티모달
                                div
                                    span 유형
                                    strong {{card.typeLabel}}
                            div(class="source-stats")
                                span 조회수 · {{card.views}}
                                span 다운로드 · {{card.downloads}}
                                span 용량 · {{card.volume}}
                            a(*ngIf="card.url", class="source-link", [href]="card.url", target="_blank", rel="noopener noreferrer") {{card.sourceName || 'AI-Hub 링크'}}
                        p(class="source-note") {{card.note}}
                div(*ngIf="slide.sample", class="source-sample-panel")
                    img([src]="slide.sample.image", [alt]="slide.sample.label", class="source-sample-img")
                    div(class="source-sample-copy")
                        span(class="source-sample-label") {{slide.sample.label}}
                        strong(class="source-sample-title") {{slide.sample.title}}
                        p(class="source-sample-desc") {{slide.sample.desc}}
                    div(class="source-sample-facts")
                        span(*ngFor="let fact of slide.sample.facts") {{fact}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── DATA USAGE SLIDE ────────────────────────────────────
        ng-container(*ngIf="slide.type === 'usage'")
            div(class="slide-content visual-slide", [ngClass]="slide.compact ? 'is-compact' : ''")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="usage-summary-grid")
                    div(*ngFor="let item of slide.summary", class="usage-summary-card")
                        span {{item.label}}
                        strong {{item.value}}
                div(class="usage-stack")
                    div(*ngFor="let row of slide.rows", class="usage-row", [ngClass]="toneClass(row.tone)")
                        div(class="usage-row-head")
                            strong {{row.label}}
                            span 확보 {{row.acquired}} · 사용 {{row.used}}
                        div(class="usage-bar")
                            div(class="usage-bar-fill", [style.width.%]="row.width")
                        p(class="usage-detail") {{row.detail}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── SCOREBOARD SLIDE ─────────────────────────────────────
        ng-container(*ngIf="slide.type === 'scoreboard'")
            div(class="slide-content visual-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="score-grid")
                    div(*ngFor="let m of slide.metrics", class="score-card", [ngClass]="toneClass(m.color)")
                        span(class="score-label") {{m.label}}
                        strong(class="score-value") {{m.value}}
                        span(class="score-sub") {{m.sub}}
                div(*ngIf="slide.callout", class="visual-callout") {{slide.callout}}
                div(*ngIf="slide.featureGroups", class="feature-group-grid")
                    div(*ngFor="let group of slide.featureGroups", class="feature-group-card", [ngClass]="toneClass(group.tone)")
                        div(class="feature-group-count") {{group.count}}
                        div(class="feature-group-copy")
                            strong {{group.title}}
                            p {{group.desc}}
                div(*ngIf="slide.features", class="feature-chip-grid")
                    span(*ngFor="let feature of slide.features", class="feature-chip") {{feature}}

        //- ── LANE / POLICY SLIDE ─────────────────────────────────
        ng-container(*ngIf="slide.type === 'lanes'")
            div(class="slide-content visual-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="lane-stack")
                    div(*ngFor="let lane of slide.lanes", class="lane-card", [ngClass]="toneClass(lane.tone)")
                        div(class="lane-main")
                            span(class="lane-label") {{lane.label}}
                            strong(class="lane-value") {{lane.value}}
                            span(class="lane-desc") {{lane.desc}}
                        div(class="lane-bar-track")
                            div(class="lane-bar-fill", [style.width.%]="lane.width")
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── THRESHOLD COMPARE SLIDE ─────────────────────────────
        ng-container(*ngIf="slide.type === 'compare'")
            div(class="slide-content visual-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="compare-grid")
                    div(*ngFor="let card of slide.cards", class="compare-card", [ngClass]="card.recommended ? 'is-recommended' : ''")
                        div(class="compare-head")
                            span(class="compare-label") {{card.label}}
                            strong(class="compare-threshold") {{card.threshold}}
                        p(class="compare-meta") {{card.meta}}
                        div(class="compare-bars")
                            div(*ngFor="let b of card.bars", class="compare-bar-row")
                                div(class="compare-bar-meta")
                                    span {{b.label}}
                                    strong {{b.value | number:'1.2-2'}}%
                                div(class="mini-bar-track")
                                    div(class="mini-bar-fill", [ngClass]="toneClass(b.tone)", [style.width.%]="b.value")
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── BAR CHART SLIDE ─────────────────────────────────────
        ng-container(*ngIf="slide.type === 'bars'")
            div(class="slide-content visual-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(*ngIf="slide.legend", class="chart-legend")
                    span(*ngFor="let l of slide.legend", class="legend-item")
                        i([ngClass]="toneClass(l.tone)")
                        span {{l.label}}
                div(class="bar-chart")
                    div(*ngFor="let row of slide.bars", class="bar-chart-row")
                        div(class="bar-row-label")
                            strong {{row.label}}
                            span {{row.sample}}
                        div(class="bar-pair")
                            div(class="bar-line")
                                div(class="bar-line-fill tone-emerald", [style.width.%]="row.recall")
                                span(class="bar-value") {{row.recall | number:'1.2-2'}}%
                            div(class="bar-line")
                                div(class="bar-line-fill tone-cyan", [style.width.%]="row.precision")
                                span(class="bar-value") {{row.precision | number:'1.2-2'}}%
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── CONFUSION MATRIX SLIDE ──────────────────────────────
        ng-container(*ngIf="slide.type === 'matrix'")
            div(class="slide-content visual-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="matrix-layout")
                    div(class="matrix-grid", [style.gridTemplateColumns]="matrixColumns(slide.labels)")
                        div(class="matrix-corner") actual / pred
                        div(*ngFor="let label of slide.labels", class="matrix-head") {{label}}
                        ng-container(*ngFor="let row of slide.matrix; let ri = index")
                            div(class="matrix-row-head") {{slide.labels[ri]}}
                            div(*ngFor="let cell of row", class="matrix-cell", [ngStyle]="heatStyle(cell, slide.max)") {{cell}}
                    div(class="matrix-insights")
                        p(class="matrix-insight-title") 핵심 해석
                        ul
                            li(*ngFor="let item of slide.insights") {{item}}

        //- ── BULLETS SLIDE ───────────────────────────────────────
        ng-container(*ngIf="slide.type === 'bullets'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="slide-body-bullets")
                    div(*ngFor="let g of slide.groups", class="bullet-group")
                        p(class="bullet-group-label") {{g.label}}
                        ul(class="bullet-list")
                            li(*ngFor="let item of g.items", class="bullet-item")
                                span(class="bullet-dot")
                                span {{item}}

        //- ── TWO COLUMN SLIDE ────────────────────────────────────
        ng-container(*ngIf="slide.type === 'twocol'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="slide-body-twocol")
                    div(class="twocol-card", [ngClass]="colClass(slide.left.color)")
                        p(class="twocol-label", [ngClass]="colTextClass(slide.left.color)") {{slide.left.label}}
                        ul(class="twocol-list")
                            li(*ngFor="let item of slide.left.items", class="twocol-item")
                                ng-container(*ngIf="item?.desc")
                                    span(class="font-semibold") {{item.label}}
                                    span(class="ml-1 opacity-70") — {{item.desc}}
                                ng-container(*ngIf="!item?.desc") {{item}}
                    div(class="twocol-card", [ngClass]="colClass(slide.right.color)")
                        p(class="twocol-label", [ngClass]="colTextClass(slide.right.color)") {{slide.right.label}}
                        ul(class="twocol-list")
                            li(*ngFor="let item of slide.right.items", class="twocol-item")
                                ng-container(*ngIf="item?.desc")
                                    span(class="font-semibold") {{item.label}}
                                    span(class="ml-1 opacity-70") — {{item.desc}}
                                ng-container(*ngIf="!item?.desc") {{item}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── PIPELINE SLIDE ──────────────────────────────────────
        ng-container(*ngIf="slide.type === 'pipeline'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="pipeline-flow")
                    ng-container(*ngFor="let step of slide.steps; let i = index; let last = last")
                        div(class="pipeline-step", [ngClass]="pipelineHighlightClass(step)")
                            span(class="pipeline-icon") {{step.icon}}
                            span(class="pipeline-label") {{step.label}}
                        div(*ngIf="!last", class="pipeline-arrow")
                            svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-4 text-slate-400")
                                path(stroke-linecap="round", stroke-linejoin="round", d="m8.25 4.5 7.5 7.5-7.5 7.5")
                div(class="pipeline-roles")
                    div(*ngFor="let r of slide.roles", class="pipeline-role-card")
                        p(class="pipeline-role-label") {{r.label}}
                        p(class="pipeline-role-desc") {{r.desc}}

        //- ── TABLE SLIDE ─────────────────────────────────────────
        ng-container(*ngIf="slide.type === 'table'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="slide-body-tables")
                    div(*ngFor="let tbl of slide.tables", class="pres-table-wrap")
                        p(*ngIf="tbl.title", class="pres-table-caption") {{tbl.title}}
                        div(class="overflow-x-auto")
                            table(class="pres-table")
                                thead
                                    tr
                                        th(*ngFor="let h of tbl.headers", class="pres-th") {{h}}
                                tbody
                                    tr(*ngFor="let row of tbl.rows; let odd = odd",
                                        [ngClass]="odd ? 'bg-slate-50' : 'bg-white'")
                                        td(*ngFor="let cell of row", class="pres-td") {{cell}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── SCREENSHOT SLIDE ─────────────────────────────────────
        ng-container(*ngIf="slide.type === 'screenshot'")
            div(class="slide-content visual-slide screenshot-slide")
                div(class="slide-header visual-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="screenshot-layout")
                    div(class="screenshot-frame")
                        img([src]="slide.image", [alt]="slide.title", class="screenshot-image")
                    div(class="screenshot-copy")
                        div(*ngFor="let point of slide.points", class="screenshot-point")
                            span(class="screenshot-dot")
                            p {{point}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── CASES SLIDE ─────────────────────────────────────────
        ng-container(*ngIf="slide.type === 'cases'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                div(class="slide-body-cases")
                    div(*ngFor="let c of slide.cases", class="case-card",
                        [ngClass]="colClass(c.color)")
                        p(class="case-label", [ngClass]="colTextClass(c.color)") {{c.label}}
                        div(class="case-row")
                            span(class="case-key") 영상
                            span(class="case-value font-mono text-xs") {{c.file}}
                        div(class="case-row")
                            span(class="case-key") 로그
                            span(class="case-value") {{c.log}}
                        div(class="case-row")
                            span(class="case-key") 분석
                            span(class="case-value") {{c.analysis}}
                        div(class="case-row")
                            span(class="case-key") 수정
                            span(class="case-value") {{c.fix}}
                        div(class="case-point mt-2", [ngClass]="accentClass(c.color, 'badge')") 💡 {{c.point}}

        //- ── VIDEO SLIDE ─────────────────────────────────────────
        ng-container(*ngIf="slide.type === 'video'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                p(*ngIf="slide.description", class="slide-data-desc") {{slide.description}}
                div(class="video-slide-body")
                    div(class="video-main-wrap")
                        video(class="video-main",
                            [attr.src]="slide.videoSrc",
                            controls="",
                            autoplay="",
                            muted="",
                            loop="",
                            playsinline="") 영상을 재생할 수 없습니다.
                    div(*ngIf="slide.panels", class="video-panels")
                        div(*ngFor="let p of slide.panels", class="video-panel-card")
                            p(class="video-panel-label") {{p.label}}
                            p(class="video-panel-value") {{p.value}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

        //- ── DATA SLIDE ──────────────────────────────────────────
        ng-container(*ngIf="slide.type === 'data'")
            div(class="slide-content")
                div(class="slide-header")
                    span(class="slide-badge", [ngClass]="accentClass(slide.accent, 'badge')") {{slide.badge}}
                    h2(class="slide-title") {{slide.title}}
                p(*ngIf="slide.description", class="slide-data-desc") {{slide.description}}
                div(class="data-samples-grid")
                    div(*ngFor="let s of slide.samples", class="data-sample-card")
                        div(class="data-sample-img-wrap")
                            img([src]="s.image", [alt]="s.label", class="data-sample-img")
                        div(class="data-sample-info")
                            p(class="data-sample-label") {{s.label}}
                            p(class="data-sample-desc") {{s.desc}}
                div(*ngIf="slide.note", class="slide-note") {{slide.note}}

    //- ── NAV BUTTONS ───────────────────────────────────────────────
    button(type="button",
        class="pres-nav pres-nav-prev",
        [disabled]="current === 0",
        (click)="prev()")
        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-6")
            path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 19.5 8.25 12l7.5-7.5")

    button(type="button",
        class="pres-nav pres-nav-next",
        [disabled]="current === total - 1",
        (click)="next()")
        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-6")
            path(stroke-linecap="round", stroke-linejoin="round", d="m8.25 4.5 7.5 7.5-7.5 7.5")

    //- ── KEYBOARD HINT ─────────────────────────────────────────────
    div(class="pres-hint")
        span ← → 이동
        span · Space 다음
        span · Tab 목록
        span · F 전체화면
        span · Esc 나가기

    //- ── OVERVIEW PANEL ────────────────────────────────────────────
    div(*ngIf="overview", class="overview-backdrop", (click)="toggleOverview()")
    div(*ngIf="overview", class="overview-panel")
        div(class="overview-header")
            span(class="text-[15px] font-bold text-slate-900") 슬라이드 목록
            button(type="button", class="pres-topbtn", (click)="toggleOverview()")
                svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor", class="size-4")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M6 18 18 6M6 6l12 12")
        div(class="overview-grid")
            button(*ngFor="let s of slides; let i = index",
                type="button",
                class="overview-thumb",
                [ngClass]="i === current ? 'ring-2 ring-indigo-500 bg-indigo-50' : 'bg-white hover:bg-slate-50'",
                (click)="goTo(i)")
                span(class="overview-num") {{i + 1}}
                span(class="overview-badge-sm") {{truncate(s.badge || s.title, 24)}}
                p(class="overview-title-sm") {{truncate(s.title)}}
