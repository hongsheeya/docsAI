doctype html
html(lang="en")
    head
        meta(charset="utf-8")
        title DocsAI
        base(href="/")
        
        meta(name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0')
        meta(http-equiv='X-UA-Compatible' content='ie=edge')

        // pwa config
        meta(name='msapplication-TileColor' content='#080808')
        meta(name='theme-color' content='#080808')
        meta(name='apple-mobile-web-app-status-bar-style' content='black')
        meta(name='apple-mobile-web-app-capable' content='yes')
        meta(name='apple-mobile-web-app-title' content='DocsAI')
        meta(name='mobile-web-app-capable' content='yes')
        meta(name='HandheldFriendly' content='True')
        meta(name='MobileOptimized' content='320')
        link(rel="shortcut icon", href="/assets/brand/favicon.svg", type="image/svg+xml")

        link(rel="apple-touch-icon" sizes="72x72" href="/assets/brand/favicon.svg")
        link(rel="apple-touch-icon" sizes="114x114" href="/assets/brand/favicon.svg")
        link(rel="apple-touch-icon" href="/assets/brand/favicon.svg")

        link(rel="icon" sizes="72x72" href="/assets/brand/favicon.svg")
        link(rel="icon" sizes="114x114" href="/assets/brand/favicon.svg")
        link(rel="icon" sizes="192x192" href="/assets/brand/favicon.svg")
        link(rel="icon" sizes="57x57" href="/assets/brand/favicon.svg")

        link(rel="manifest" href="/manifest.json")

        script(type="text/javascript").
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/sw.js', {scope: '/'}).then((reg) => {});
            }

    body
        app-root
